{
  "name": "liftoff-tenant-runtime",
  "version": "0.1.0",
  "description": "Liftoff Tenant Runtime - Execution Plane",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:reconcile": "RECONCILE_MODE=true node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "check:deps": "node scripts/check-dependency-integrity.js",
    "pretest": "npm run check:deps",
    "pretest:browser": "npm run check:deps",
    "pretypecheck": "npm run check:deps",
    "prebuild": "npm run check:deps",
    "test": "jest",
    "test:changed": "jest --changedSince=main",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --config jest.integration.config.js",
    "test:fault-injection": "jest --config jest.fault-injection.config.js",
    "test:validation": "jest --config jest.validation.config.js tests/validation-rig/",
    "test:browser": "jest --config jest.browser.config.js",
    "migrate": "node-pg-migrate",
    "reconcile": "ts-node src/jobs/meter-reconciliation.ts",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "certify": "node dist/scripts/certify-engines.js",
    "prepare": "husky || true",
    "cache-benchmark": "node dist/scripts/cache-benchmark.js"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@ai-sdk/anthropic": "^1.2.12",
    "@ai-sdk/openai": "^1.3.24",
    "@ai-sdk/xai": "^1.2.18",
    "@anthropic-ai/claude-agent-sdk": "0.3.220",
    "@anthropic-ai/sdk": "^0.80.0",
    "@browserbasehq/sdk": "2.16.0",
    "@browserbasehq/stagehand": "^2.5.9",
    "@composio/core": "^0.10.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-express": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@google-cloud/aiplatform": "^3.0.0",
    "@google-cloud/dlp": "^5.13.0",
    "@google-cloud/kms": "^4.0.0",
    "@google-cloud/monitoring": "^5.3.1",
    "@google-cloud/opentelemetry-cloud-monitoring-exporter": "^0.21.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@google-cloud/pubsub": "^4.0.0",
    "@google-cloud/scheduler": "^5.3.1",
    "@google-cloud/secret-manager": "^5.0.0",
    "@google-cloud/storage": "^7.0.0",
    "@google-cloud/tasks": "^4.0.0",
    "@google-cloud/trace-agent": "^8.0.0",
    "@google-cloud/vertexai": "^1.0.0",
    "@google/adk": "^1.5.0",
    "@google/genai": "^1.52.0",
    "@liftoffos/agent-test-scenarios": "*",
    "@liftoffos/browser-record": "*",
    "@liftoffos/chat-attachments": "*",
    "@liftoffos/composio-overlays": "*",
    "@liftoffos/connector-types": "*",
    "@liftoffos/database": "*",
    "@liftoffos/embedding": "*",
    "@liftoffos/governance-types": "*",
    "@liftoffos/injection-detector": "*",
    "@liftoffos/runtime-mcp-transports": "*",
    "@liftoffos/proto-gen": "*",
    "@liftoffos/pubsub": "*",
    "@liftoffos/redact": "*",
    "@liftoffos/service-client": "*",
    "@liftoffos/runtime-shared-types": "*",
    "@liftoffos/telemetry": "*",
    "@liftoffos/turn-bounds": "*",
    "@mozilla/readability": "0.6.0",
    "@openai/agents": "^0.18.0",
    "@openai/codex-sdk": "^0.146.0",
    "@opencode-ai/sdk": "^1.18.15",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.221.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-logs": "^0.221.0",
    "@opentelemetry/sdk-metrics": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "ai": "^4.3.19",
    "ajv": "^8.18.0",
    "docx": "^9.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.0",
    "fast-xml-parser": "^5.10.1",
    "google-auth-library": "^9.4.2",
    "jsdom": "24.1.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "node-addon-api": "8.9.1",
    "node-sql-parser": "5.4.0",
    "openai": "^4.0.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.0",
    "playwright-core": "1.62.1",
    "pptxgenjs": "^4.0.1",
    "re2": "^1.21.4",
    "stripe": "^14.0.0",
    "tiktoken": "^1.0.18",
    "turndown": "7.2.4",
    "uuid": "^9.0.0",
    "zod": "^4.0.0"
  },
  "overrides": {
    "@opentelemetry/api-logs": "$@opentelemetry/api-logs",
    "@opentelemetry/sdk-logs": "$@opentelemetry/sdk-logs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "eslint": "^10.9.1",
    "fast-check": "^4.6.0",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "lint-staged": "^16.4.0",
    "msw": "^2.12.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.68.0",
    "undici": "^6.29.1"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "bash -c tsc --noEmit"
    ]
  }
}
