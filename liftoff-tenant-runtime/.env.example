# Liftoff Tenant Runtime - Environment Variables
# Copy this file to .env and fill in the values

# ==============================================================================
# REQUIRED - Core Configuration
# ==============================================================================

| Variable | Required | Description |
|----------|----------|-------------|
# DATABASE_URL          | Yes | PostgreSQL connection string (tenant database)
# GCP_PROJECT_ID        | Yes | GCP project ID for this tenant
# ENVIRONMENT           | Yes | Environment name (dev, staging, prod)

# Database connection (tenant-specific database)
DB_HOST=localhost
DB_NAME=tenant_dev
DB_USER=postgres
DB_PASSWORD=password
DB_PORT=5432

# Or use a connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/tenant_dev

# GCP Configuration
GCP_PROJECT_ID=YOUR_TENANT_PROJECT
# GCP_PROJECT is an alias for GCP_PROJECT_ID used by some GCP client libraries.
# Set both to the same value.
GCP_PROJECT=YOUR_TENANT_PROJECT
GCP_LOCATION=us-west1
ENVIRONMENT=dev

# ==============================================================================
# REQUIRED - Control Plane Connection
# ==============================================================================

# URL of the Platform Backend (Control Plane)
CONTROL_PLANE_API_URL=http://localhost:8080

# Public URL of this Tenant Runtime service
TENANT_RUNTIME_URL=http://localhost:4000

# ==============================================================================
# REQUIRED on coordinator-service - Pub/Sub Push Handler
# ==============================================================================
# coordinator-service exposes POST /internal/pubsub/:topic for control-plane
# event push delivery. The handler verifies the inbound OIDC bearer token's
# audience and email claims against these env vars; index.ts startup-guards
# both being set when SERVICE_TYPE=coordinator (or monolith) before the
# listener binds. See README "Events Received (Pub/Sub Push Subscriber)" and
# Liftoff-Infrastructure-GCP/terraform/projects/tenant-runtime-template/pubsub_push.tf.

# Cloud Run URL of THIS coordinator-service (no trailing slash). Pub/Sub mints
# push-token `aud` to this exact value. In prod this is set automatically by
# cloudbuild's deploy-coordinator-service step.
COORDINATOR_SERVICE_URL=http://localhost:4000

# Email of the dedicated Pub/Sub push SA living in YOUR_GCP_PROJECT.
# The OIDC `email` claim must match this exact value.
PUBSUB_PUSH_SA_EMAIL=YOUR_SERVICE_ACCOUNT@YOUR_PROJECT.iam.gserviceaccount.com

# ==============================================================================
# REQUIRED - LLM Providers
# ==============================================================================

# OpenAI API key (primary LLM provider)
OPENAI_API_KEY=

# OpenRouter API key — required by the openrouter (opencode) agent engine so the
# spawned opencode server can reach OpenRouter. In prod this hydrates at startup
# from the cross-project secret YOUR_GCP_PROJECT/openrouter-api-key
# (SECRET_MANIFEST in src/infrastructure/secrets.ts, same pattern as OPENAI_API_KEY);
# the runtime SA needs secretAccessor on it (granted alongside openai-api-key in
# tenant-runtime-template's runtime_web_tool_keys). Leave unset unless the
# openrouter engine is selected (OPENROUTER_ENGINE=opencode below).
OPENROUTER_API_KEY=

# Anthropic API key (if using Anthropic directly)
ANTHROPIC_API_KEY=

# Composio API key — used by tool-gateway/composio-dispatcher to call
# composio.tools.execute for composio_managed connectors (Gmail, Outlook,
# Slack, Drive, OneDrive, SharePoint, Box, Jira, Confluence, Dropbox,
# YouTube, Calendly, PayPal, the 7 Tier-1 connectors). In prod this
# mounts from the cross-project secret YOUR_GCP_PROJECT/
# composio-api-key via the cloudbuild secret-mirror pattern. Required on
# both agent-service and tool-gateway-service — without it,
# composio-dispatcher throws "COMPOSIO_API_KEY env var not set on
# tenant-runtime" at first dispatch and every composio_managed tool
# call is silently stranded.
COMPOSIO_API_KEY=

# ==============================================================================
# OPTIONAL - Execution engines + adapter plane
# ==============================================================================

# Self-managing vendor-SDK engine selectors (ADR-004,
# docs/adr/004-self-managing-vendor-engines.md). Each non-Anthropic provider has
# a self-compacting engine picked in createAdapter via these flags; unset ⇒ the
# default in-house adapter for that provider (openai-agents / openrouter-openai-
# wire / google-genai). See src/agent-execution/adapter/engine-resolver.ts.
#   OPENAI_ENGINE=codex        → @openai/codex-sdk  (else openai-agents)
#   OPENROUTER_ENGINE=opencode → @opencode-ai/sdk   (else openrouter-openai-wire)
#   GOOGLE_ENGINE=adk          → @google/adk         (else google-genai)
# OPENAI_ENGINE=
# GOOGLE_ENGINE=
# OPENROUTER_ENGINE=

# code_session coding-model overrides for the OpenRouter-served vendors
# (GLM / Qwen / DeepSeek / Kimi / Grok share provider 'openrouter'; the runner
# picks the model by the OUTER agent's model-id vendor prefix — see
# adapter/tools/code-session/runners/openrouter.ts). Unset ⇒ each vendor's
# large model: z-ai/glm-5.2, qwen/qwen3.8-max, deepseek/deepseek-v4-pro,
# moonshotai/kimi-k3, x-ai/grok-4.6.
# OPENROUTER_CODE_MODEL=
# OPENROUTER_QWEN_CODE_MODEL=
# OPENROUTER_DEEPSEEK_CODE_MODEL=
# OPENROUTER_KIMI_CODE_MODEL=
# OPENROUTER_GROK_CODE_MODEL=

# Deterministic, zero-LLM size bound on tool results for the OpenAI / OpenRouter
# / Gemini hybrid loops (Anthropic bypasses the mcp-bridge and is unaffected).
# src/agent-execution/adapter/tool-result-bound.ts. Off unless set to exactly '1';
# calibrate TOOL_RESULT_MAX_CHARS against real result sizes + the smallest engine
# context window before enabling widely.
# TOOL_RESULT_BOUND_ENABLED=
# Per-result character budget when the bound is enabled. Default 50000 (~12k tokens).
# TOOL_RESULT_MAX_CHARS=50000

# The Claude Agent SDK's own tool search is ON BY DEFAULT: it withholds MCP tool
# definitions and loads only what a turn needs (104 deferred tools measured on a
# live run). Neither variable below is set anywhere, and both are listed so a
# change is a decision rather than an accident.
#   ENABLE_TOOL_SEARCH=auto:N   tune the threshold (N = % of context)
#   CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS=1  strips the beta headers and
#     PERMANENTLY disables tool search — it wins over ENABLE_TOOL_SEARCH, and the
#     result is every tool schema inline on every call.
# Tools our prompts name by vocabulary are opted out per tool via `alwaysLoad`
# (src/agent-execution/adapter/tool-tiering.ts, isAlwaysLoadedTool), not by
# turning search off.
# ENABLE_TOOL_SEARCH=

# Condense a long conversation's older turns into one summary, keeping the most
# recent verbatim, on the same three loops (the engines that manage their own
# context never reach it). src/agent-execution/history-compaction.ts. Off unless
# set to exactly '1'. Requires SEMANTIC_COMPRESSION_ENABLED=1: the summary comes
# from that pass, and without it this declines rather than compacting.
# HISTORY_COMPACTION_ENABLED=
# Operator override for the retained tail, as a message COUNT. Unset — the normal
# case — retains what fits the pressure-ratio character budget instead, which is
# the only one of the two that knows how big a message is.
# HISTORY_COMPACT_RETAIN=

# ==============================================================================
# OPTIONAL - API Key Connectors
# ==============================================================================
# These connectors use per-tenant API keys stored in Secret Manager as accessToken.
# No OAuth client registration required — users provide their own API keys.

# Pipedrive (CRM) — stored per-tenant as credentials.accessToken
# PIPEDRIVE_API_TOKEN=

# SendGrid (Email) — stored per-tenant as credentials.accessToken
# SENDGRID_API_KEY=

# ==============================================================================
# OPTIONAL - OAuth Client Credentials
# ==============================================================================
# Used for refreshing OAuth tokens for connectors

# Google Workspace
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Atlassian (Jira/Confluence)
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=

# Zendesk
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=

# Intercom
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=

# Square (static OAuth — Register at developer.squareup.com)
SQUARE_CLIENT_ID=
SQUARE_CLIENT_SECRET=

# Trello (API key + per-user OAuth token)
# TRELLO_API_KEY is the static app-level key from https://trello.com/app-key
# The per-user OAuth token is stored per-connector install as credentials.accessToken
TRELLO_API_KEY=

# ==============================================================================
# DCR Connectors — NO env vars needed (token refresh reads metadata from Secret Manager)
# ==============================================================================
# The following connectors use RFC 7591 Dynamic Client Registration. The Platform
# Backend discovers OAuth endpoints and registers a client at runtime. The resulting
# {tokenEndpoint, clientId} is stored in credential metadata in Secret Manager.
# Tenant Runtime's refreshDiscoveryToken() reads that metadata for token refresh.
#
# DO NOT add CLIENT_ID/SECRET vars here for these connectors:
#   Linear (mcp.linear.app/mcp), Notion (mcp.notion.com/mcp),
#   Asana (mcp.asana.com/v2/mcp), Calendly (mcp.calendly.com/mcp),
#   PayPal (mcp.paypal.com/sse), Datadog (mcp.datadoghq.com/...)
#
# For local dev only: set the corresponding vars in .env (not .env.example) to
# bypass discovery with a manually-created app on the vendor portal.

# ==============================================================================
# OPTIONAL - Memory & Embeddings
# ==============================================================================

# Embedding provider (vertex, openai, voyage)
EMBEDDING_PROVIDER=google

# Voyage AI API key (if using Voyage embeddings)
VOYAGE_API_KEY=

# Vertex AI location for embeddings
VERTEX_LOCATION=us-west1

# ==============================================================================
# OPTIONAL - Encryption (Cloud KMS)
# ==============================================================================

# KMS project for memory encryption
KMS_PROJECT_ID=

# KMS location
KMS_LOCATION=us-west1

# KMS keyring name
KMS_KEYRING=tenant-encryption

# KMS key name for memory content encryption
KMS_KEY=memory-content

# ==============================================================================
# OPTIONAL - Cloud Storage
# ==============================================================================

# GCS bucket for payload archival
PAYLOAD_ARCHIVE_BUCKET=payload-archive

# ==============================================================================
# OPTIONAL - Internal Services
# ==============================================================================

# URL for connector sync service
CONNECTOR_SYNC_URL=

# URL for tool gateway service
TOOL_GATEWAY_URL=

# Base URL of the MCP sidecar HTTP server (serves all self-hosted connector MCP wrappers).
# Locally: http://localhost:8100 (start the sidecar server separately with: npm run sidecar)
# Cloud Run multi-container: http://localhost:8100 (sidecar container shares network namespace)
# When unset, self-hosted sidecar connectors fall through to REST clients where available.
# Required for: zendesk, atlassian_jira, atlassian_confluence, bamboohr, gusto, rippling,
#               docusign, linear, hubspot_write — these have no REST fallback.
MCP_SIDECAR_URL=http://localhost:8100

# ==============================================================================
# OPTIONAL - Workspace Security
# ==============================================================================

# Secret Manager resource name for the UntrustedContentFramer server secret.
# Required for interactive chat turns; autonomous agent execution does not use it.
# Defaults to: projects/${GCP_PROJECT}/secrets/framer-secret/versions/latest
# Override only if the secret lives in a different project or uses a pinned version.
FRAMER_SECRET_NAME=

# Kill-switch for untrusted tool-output framing (ADR-031). When 'false' or '0',
# frameUntrusted() returns content unchanged for ALL sites (connector results,
# vendor-hosted MCP results, sandbox file reads) without a redeploy. Framing is
# ON by default; leave unset to keep it on.
# CONNECTOR_OUTPUT_FRAMING_ENABLED=

# Byte threshold for the detect-don't-block egress signal (ADR-031). When an
# agent that holds a connector binding calls a web_fetch-family tool with a URL
# whose query+fragment carries at least this many bytes, a
# security.possible_egress_exfil audit row is emitted (detection only, never
# blocks). Tune against real traffic without a redeploy. Default: 512.
# EGRESS_EXFIL_QUERY_BYTES=512

# ==============================================================================
# OPTIONAL - Monitoring
# ==============================================================================

# ── Sandbox Execution Environments ────────────────────────────────────────
# Credit-to-USD conversion rate for sandbox costs on /insights
SANDBOX_CREDIT_TO_USD=0.001

# ── Monitoring ────────────────────────────────────────────────────────────
# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable OpenTelemetry tracing
OTEL_ENABLED=false

# Cloud Trace project ID
TRACE_PROJECT_ID=

# ==============================================================================
# OPTIONAL - Connector Service (Phase 1c — platform decomposition)
# ==============================================================================

# Base URL of the extracted liftoff-connector-service.
CONNECTOR_SERVICE_URL=http://localhost:8080

# Shared X-Service-Auth token used by tenant-runtime → connector-service.
# Rotated via Secret Manager in prod.
CONNECTOR_SERVICE_TOKEN=

# Shared X-Service-Auth token used by tenant-runtime's agent + tool-gateway
# services → platform-backend's /api/internal/agent-slack/* endpoints
# (installs lookup, post-review-dm fan-out, post-draft-dm fan-out, assignees).
# Provisioned by terraform (platform-control/main.tf:agent_slack_service_token)
# and mirrored into each per-tenant project at deploy time.
AGENT_SLACK_SERVICE_TOKEN=

# Shared X-Service-Auth token used by tenant-runtime's agent + tool-gateway
# services → platform-backend's /api/internal/agent-teams/* endpoints
# (conversations lookup, send / send-dm, user-info, thread, post-review-card,
# assignees) for the outbound Microsoft Teams tools. Unlike Slack there are no
# per-agent bot tokens — one shared multi-tenant Liftoff Teams bot serves every
# agent, and platform-backend holds the bot adapter + credentials.
AGENT_TEAMS_SERVICE_TOKEN=

# Shadow-mode rollout flag. Values: off (default) | shadow | on
#   off    — connector-service not called; legacy in-process path owns the work.
#   shadow — both paths execute; responses compared, legacy path serves the
#            user. Used for 48h validation before flipping to `on`.
#   on     — connector-service owns the path; legacy path dormant (removed in
#            Phase 2).
CONNECTOR_SERVICE_ENABLED=off

# ==============================================================================
# OPTIONAL - Governance Engine (Phase 3 — governance decomposition)
# ==============================================================================

# Base URL of the extracted governance-engine Cloud Run service. Resolved
# dynamically at deploy time (see cloudbuild.yaml). Leave blank in local dev
# unless you're running governance-engine locally.
GOVERNANCE_SERVICE_URL=

# Shared X-Service-Auth token used by tenant-runtime → governance-engine.
# Rotated via Secret Manager in prod. Plan convention is
# GOVERNANCE_SERVICE_TOKEN; the underlying Secret Manager resource is still
# named `governance-engine-token`.
GOVERNANCE_SERVICE_TOKEN=

# Shadow-mode rollout flag. Values: off (default) | shadow | on
#   off    — governance-engine not called; in-process admission+allowlist path
#            owns the work. No WAL drainer or kill-switch subscriber starts.
#   shadow — both paths execute; RPC mismatches logged, legacy serves.
#            WAL drainer + kill-switch subscriber run.
#   on     — governance-engine RPC owns authorize; fails CLOSED (re-throws)
#            on RPC error. Record is still WAL-durable.
GOVERNANCE_SERVICE_ENABLED=off

# ==============================================================================
# schedule_followup quota overrides (optional)
# ==============================================================================
# Defaults: 5000 pending per agent, 50000 pending per tenant.
# SCHEDULE_FOLLOWUP_PER_AGENT_QUOTA=5000
# SCHEDULE_FOLLOWUP_PER_TENANT_QUOTA=50000

# ==============================================================================
# Hermes runtime extensions — delegation + trajectory sink (optional)
# ==============================================================================
# Delegation tool is only discoverable when this is exactly 'true'
# (src/tool-gateway/mcp-server.ts). Scoped to agent-service via cloudbuild.
# DELEGATION_ENABLED=false
# Trajectory sink: env flag overrides the per-tenant DB flag. Set to 'false'
# to force-disable; any other value leaves the per-tenant flag in control
# (src/agent-execution/service.ts).
# TRAJECTORY_SINK_ENABLED=
# Collab-session emitter (fail-safe, advisory). Only emits when exactly 'true';
# operator-managed on agent-service (preserved across deploys via cloudbuild).
# COLLAB_SESSIONS_ENABLED=false
# Capture redacted deliverable files into the session (best-effort). Only when 'true'.
# COLLAB_ARTIFACT_SNAPSHOT_ENABLED=false
# ISO timestamp of the migration-312 rollout — backfill treats a run completing
# at/before this with no correlated HITL rows as unattributable (null), else zero.
# COLLAB_HITL_CORRELATION_SINCE=2026-07-23T00:00:00Z
# Deliverable grader (diagnostics job passes). Grader config also rides the
# /harvest request body, so these only gate the job-driven passes.
# DIAGNOSTICS_GRADER_ENABLED=false
# DIAGNOSTICS_GRADER_JUDGES=anthropic:large,google:large
# DIAGNOSTICS_RUBRIC_MODEL=anthropic:large
# DIAGNOSTICS_LABELED_SET_PATH=gs://.../labeled-grader-set.json
# Delegation defaults (overridable per-tenant; hard caps enforced in code).
# src/agent-execution/delegation-defaults.ts
# MAX_DELEGATION_DEPTH=1
# MAX_DELEGATION_FANOUT=16
# DEFAULT_MAX_CONCURRENT_CHILDREN=8

# ==============================================================================
# Sandbox executor (optional)
# ==============================================================================
# Base URL of the sandbox executor sidecar. Falls back to
# TENANT_RUNTIME_INTERNAL_URL (monolith) when unset (src/index.ts).
# SANDBOX_EXECUTOR_URL=

# Email of the dedicated, zero-role service account the per-sandbox container
# RUNS AS (ADR-031). REQUIRED in the split deployment: CloudRunSandboxProvider.
# create() FAILS CLOSED if unset and never falls back to the privileged runtime
# SA — agent code inside the sandbox must not run as the runtime SA. Set by the
# deploy to sandbox-runtime@tenant-<id>-<env>.iam.gserviceaccount.com.
# SANDBOX_SERVICE_ACCOUNT_EMAIL=

# Where code_session runs the vendor coding agent: inprocess | sandbox.
# `inprocess` puts the agent's shell in the tenant runtime's own container, as
# root, under the runtime SA; `sandbox` puts it in a per-tenant Cloud Run
# sandbox under sandbox-runtime, which holds zero project roles.
# Set on the AGENT-SERVICE deployment by cloudbuild, from ${_ENVIRONMENT}:
# sandbox in dev, inprocess in prod. Locally the default applies and nothing
# needs to be set. See docs/agent-service-flags.md.
# CODE_SESSION_EXECUTION=

# ==============================================================================
# Coverage / smoke / audit kill switches (optional)
# ==============================================================================
# Set to 1 to short-circuit the connector-tool smoke endpoint.
# CONNECTOR_TOOL_SMOKE_DISABLED=
# Dedicated maintenance agent UUID used by connector smoke dispatch; falls back
# to SCHEDULED_INVOCATION_AGENT_ID then a system-agent sentinel
# (src/connectors/tool-smoke.ts).
# CONNECTOR_SMOKE_AGENT_ID=
# Set to 1 to revert the binding probe to registry-only (src/connectors/binding-probe.ts).
# BINDING_PROBE_DEEP_DISABLED=
# Set to 1 to make the standard-tool audit emitter a no-op
# (src/audit/standard-tool-emitter.ts).
# AUDIT_LOG_STANDARD_TOOLS_DISABLED=

# ==============================================================================
# Anchor webhook receiver (only the dedicated receiver service)
# ==============================================================================
# OIDC audience / upstream agent-service URL the receiver forwards Anchor
# webhooks to (src/anchor-webhook-receiver.ts). There is NO env-wide
# ANCHOR_WEBHOOK_SECRET — the signing secret is resolved per-tenant.
# ANCHOR_WEBHOOK_UPSTREAM_URL=

# ==============================================================================
# EARNED-AUTONOMY TRUST GATE (shadow mode)
# ==============================================================================
# When 'true', checkHitlGate() consults the governance trust ledger
# (GET /api/governance/action-trust) and LOGS what it *would* auto-clear for a
# well-behaved (agent, action_class) pair, WITHOUT changing any gate decision.
# Pure observability for calibrating promote/demote thresholds before any
# enforcement. Default off; the gate behaves identically whether set or not.
# HITL_TRUST_SHADOW_ENABLED=false

# Agent Conversation Recall (plan v13 Change 4). When 'true' AND the turn is
# attributable (senderAccountId + turnId present) AND the platform callback
# client is configured AND the runtime->internal agent mapping resolves, the
# agent-service registers the recall_conversations gateway tool. Set on the
# AGENT-SERVICE deployment (cloudbuild _RECALL_CONVERSATIONS_ENABLED); the
# standalone tool-gateway service does not read it.
RECALL_CONVERSATIONS_ENABLED=false

# Self-wake (agent-initiated durable suspend/resume). When true, the agent-service
# tool-gateway registers the wake tools (sleep_until / wake_on_event|job|poll|any|all /
# cancel_wake) and startup begins the wake drain + reconcile loops. Set on the
# AGENT-SERVICE deployment by cloudbuild (SELF_WAKE_ENABLED_VAL); the standalone
# tool-gateway service does not read it. See platform-backend docs/adr/035.
SELF_WAKE_ENABLED=false

# Blast-radius gate (off | shadow | enforce). Measures how MUCH a run changes,
# cumulatively, where every other oversight rule asks what KIND of thing a call
# is. Set on the AGENT-SERVICE deployment by cloudbuild
# (get_flag agent-service QUANTIFIER_MODE shadow). `enforce` requires
# Liftoff-React to know the `blast_radius` gate reason first, or the review card
# renders a blank line where the explanation goes. See
# docs/agent-service-flags.md.
QUANTIFIER_MODE=off

# Its thresholds, read at call time so a calibration lands as configuration
# rather than a deploy. Placeholders until shadow mode has produced a
# distribution; a non-numeric value is ignored and the default stands.
QUANTIFIER_MAX_ENTITIES=25
QUANTIFIER_MAX_DESTRUCTIVE=10
QUANTIFIER_MAX_CLEARED_FIELDS=20
QUANTIFIER_MAX_PER_BATCH=15

# Recovery proposal scope. A recovery `continue` proposal may call a tool the
# workflow graph already names, or a read-only tool; a write to anything the
# graph never names is a new action nobody approved. `1` (the default in every
# environment) enforces the rule as a unit — a proposal with any call outside
# the set executes nothing and the advisor is re-asked once, a second rejection
# on the step escalates and counts (hybrid_loop.recovery_out_of_scope) — and
# narrows the advisor's catalog to the allowed set. The rule is proven by
# src/agent-execution/__tests__/recovery-proposal-scope.test.ts, which is why
# it ships on. `0` is the kill switch for a code defect in the rule: dispatch
# returns to the full catalog while every proposal is still classified, logged
# (hybrid_recovery_proposal_scope) and audited (proposedTools on the
# hybrid_recovery row). Operator-resolved on deploy (cloudbuild get_flag).
# See docs/agent-service-flags.md.
TR_RECOVERY_SCOPE_ENFORCE=1

# Takeover capture: when a person takes control of a thread's browser, one
# runtime process attaches to the session over CDP and records the pages and
# named controls they use (browser_takeover_holds / _actions, migration 418),
# for the Chief AI Officer's read of the conversation. `1` everywhere. `0`
# skips the capture claim: holds still open and close, marked capture_gap with
# gap_reason 'disabled'. It exists for a code defect that disturbs a person's
# session, not for an accounting outcome. Operator-resolved on deploy
# (cloudbuild get_flag). See docs/agent-service-flags.md.
TR_TAKEOVER_CAPTURE_ENABLED=1

# Workspace data census: background enumeration of connector METADATA (how many
# channels, deals, files exist) so an agent can learn the shape of its systems
# from a local read instead of exploratory vendor calls. Default OFF because
# enumeration spends the same vendor quota agent work does.
CENSUS_ENABLED=0

# Connector content indexing: the WRITER behind `search`'s already-indexed
# source. Indexes the result of READ tool calls into connector_content so a
# later search answers from content already fetched, at no cost to the vendor.
# Must be set on BOTH agent-service and tool-gateway-service — the indexer hangs
# off ToolGatewayService.execute(), which runs in-process for MCP dispatch and
# over HTTP for /api/v1/tool-calls. Setting one leaves half the dispatch surface
# unindexed. Watch `connector_content.indexed` / `.not_indexed`.
CONNECTOR_CONTENT_INDEXING_ENABLED=true

# Enrol Composio-routed connectors in the census. Excluded by default whatever
# CENSUS_ENABLED says: Composio bills ONE organization-wide meter (20,000
# calls/month across every tenant on the free tier) and ~90 connectors route
# through it. Setting this records that a paid-tier decision has been made.
# CENSUS_INCLUDE_COMPOSIO=1

# Ceiling on `search`'s already-indexed source per run. Each search can cost a
# HyDE call and standard tools do not pass through admission, so an unbounded
# loop would spend unbounded retrieval. Counters expire after an hour, so the
# cap can never become permanent.
INDEXED_CONTEXT_MAX_SEARCHES_PER_RUN=20

# ---------------------------------------------------------------------------
# Deletion and retention
# ---------------------------------------------------------------------------
# When a workspace deletes an agent, the control plane marks it and this
# service archives its copy. Both halves are then removed for good once the
# grace period has elapsed, including the agent's learned context, which is
# held here rather than in the control plane. Set the same values in both
# services: a workspace told "thirty days" should not find its agent gone from
# one database and present in the other.
#
# Days an archived agent survives before it is purged. Below 1 is refused.
# SOFT_DELETE_PURGE_AFTER_DAYS=30

# How often the purge runs, in hours. Safe on any number of instances: the
# pass takes a Postgres advisory lock.
# SOFT_DELETE_PURGE_INTERVAL_HOURS=12

# The purge cannot be switched off, here or in the control plane. It runs
# inside the service on every instance.
