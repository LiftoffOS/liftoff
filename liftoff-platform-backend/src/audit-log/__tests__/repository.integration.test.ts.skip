// Integration tests for the unified audit-log repository.
//
// Marked `.skip` per the convention established by
// agent-audit-logs.integration.test.ts.skip — these need a Postgres
// instance with all source tables and migration 234 applied. CI runs them
// against the ephemeral compose-up database; locally they're opt-in.
//
// To run: rename to `repository.integration.test.ts` and ensure
// DATABASE_URL points at a database where the platform-backend migrations
// have been applied (including 234_audit_query_indexes.sql).
//
// RLS NOTE: every source table the repository reads is RLS-on. The
// repository expects a tenant-scoped PoolClient (set via withTenantScope).
// These tests seed AND query under the SAME tenant-scoped session so the
// RLS predicates are exercised end-to-end. Seeding via a raw `pool.query`
// would bypass RLS and either (a) succeed where RLS would have blocked, or
// (b) miss inserts that depend on the RLS-set GUCs.

import { Pool } from 'pg';
import { withAdminScope, withTenantScope } from '../../infrastructure/database';
import { auditLogService } from '../service';

describe('audit-log repository (integration)', () => {
  const tenantA = '11111111-1111-1111-1111-111111111111';
  const tenantB = '22222222-2222-2222-2222-222222222222';
  const accountA = '33333333-3333-3333-3333-333333333333';
  const pool = new Pool({ connectionString: process.env.DATABASE_URL });

  beforeAll(async () => {
    // Seed test tenants + account via admin scope (tenants are not RLS-on
    // for INSERT). withAdminScope is the canonical "I know what I'm doing"
    // escape hatch.
    await withAdminScope(
      { caller: 'audit-log-integration-test', reason: 'test fixture seeding' },
      async (client) => {
        await client.query(
          `INSERT INTO tenants (id, name) VALUES ($1, 'Test A'), ($2, 'Test B')
           ON CONFLICT DO NOTHING`,
          [tenantA, tenantB],
        );
        await client.query(
          `INSERT INTO accounts (id, firebase_uid, email, first_name, last_name)
           VALUES ($1, 'fb-test', 'a@example.com', 'A', 'A')
           ON CONFLICT DO NOTHING`,
          [accountA],
        );
      },
    );
  });

  beforeEach(async () => {
    // Wipe source tables. TRUNCATE bypasses RLS so admin scope only.
    await withAdminScope(
      { caller: 'audit-log-integration-test', reason: 'per-test cleanup' },
      async (client) => {
        await client.query(
          `TRUNCATE TABLE
             tenant_member_audit,
             audit_log,
             internal_agent_audit,
             agent_chat_messages,
             agent_chat_threads,
             agent_audit_logs,
             event_deliveries,
             event_sources
           CASCADE`,
        );
      },
    );
  });

  afterAll(async () => {
    await pool.end();
  });

  it('returns rows from one tenant only and orders newest-first', async () => {
    const baseTime = '2026-05-21T12:00:00Z';

    // Seed tenant A rows under A's RLS scope.
    await withTenantScope(tenantA, async (client) => {
      await client.query(
        `INSERT INTO tenant_member_audit (tenant_id, account_id, action, actor_id, created_at)
         VALUES ($1, $2, 'member.invited', $2, $3::timestamptz)`,
        [tenantA, accountA, baseTime],
      );
      await client.query(
        `INSERT INTO audit_log (id, event_type, timestamp, tenant_id, user_id, resource_type, resource_id, action)
         VALUES ('a1', 'tenant.renamed', $2, $1, $3, 'tenant', $1, 'renamed')`,
        [tenantA, baseTime, accountA],
      );
      await client.query(
        `INSERT INTO internal_agent_audit (tenant_id, actor_id, action, changes, created_at)
         VALUES ($1, $2, 'archived', '{}'::jsonb, $3::timestamptz)`,
        [tenantA, accountA, baseTime],
      );
    });

    // Seed tenant B mirrors under B's RLS scope. Each session must use its
    // own tenant_id GUC — cross-tenant inserts would be rejected by RLS.
    await withTenantScope(tenantB, async (client) => {
      await client.query(
        `INSERT INTO audit_log (id, event_type, timestamp, tenant_id, user_id, resource_type, resource_id, action)
         VALUES ('b1', 'tenant.renamed', $2, $1, $3, 'tenant', $1, 'renamed')`,
        [tenantB, baseTime, accountA],
      );
    });

    // Query under tenant A's scope — should never see B's row.
    const result = await withTenantScope(tenantA, async (client) =>
      auditLogService.list(
        client,
        tenantA,
        new Date('2026-05-20T00:00:00Z'),
        new Date('2026-05-22T00:00:00Z'),
        {},
      ),
    );
    expect(result.entries.every((e) => e.tenantId === tenantA)).toBe(true);
    expect(result.entries.length).toBeGreaterThanOrEqual(3);
    for (let i = 1; i < result.entries.length; i++) {
      expect(result.entries[i - 1].createdAt >= result.entries[i].createdAt).toBe(true);
    }
  });

  it('paginates without duplicates across pages', async () => {
    // 25 rows interleaved across minutes.
    await withTenantScope(tenantA, async (client) => {
      for (let i = 0; i < 25; i++) {
        const ts = `2026-05-21T12:${String(i).padStart(2, '0')}:00Z`;
        await client.query(
          `INSERT INTO audit_log (id, event_type, timestamp, tenant_id, user_id, resource_type, resource_id, action)
           VALUES ($1, 'tenant.renamed', $2, $3, $4, 'tenant', $3, 'renamed')`,
          [`p-${i}`, ts, tenantA, accountA],
        );
      }
    });

    const collectedIds: string[] = [];
    let cursor: string | undefined;
    for (let page = 0; page < 5; page++) {
      const result = await withTenantScope(tenantA, async (client) =>
        auditLogService.list(
          client,
          tenantA,
          new Date('2026-05-21T00:00:00Z'),
          new Date('2026-05-21T23:59:59Z'),
          { limit: 10, cursor },
        ),
      );
      collectedIds.push(...result.entries.map((e) => e.id));
      if (!result.hasMore) break;
      cursor = result.nextCursor ?? undefined;
    }
    expect(collectedIds.length).toBe(25);
    expect(new Set(collectedIds).size).toBe(25); // no duplicates
  });

  it('does not duplicate rows at timestamp collisions across sources', async () => {
    // Regression for the cursor-predicate bug: page boundary at a
    // timestamp shared across multiple sources used to return the
    // alphabetically-earlier source's row again on the next page.
    const sharedTs = '2026-05-21T12:00:00Z';
    await withTenantScope(tenantA, async (client) => {
      await client.query(
        `INSERT INTO audit_log (id, event_type, timestamp, tenant_id, user_id, resource_type, resource_id, action)
         VALUES ('x1', 'tenant.renamed', $2, $1, $3, 'tenant', $1, 'renamed')`,
        [tenantA, sharedTs, accountA],
      );
      await client.query(
        `INSERT INTO tenant_member_audit (tenant_id, account_id, action, actor_id, created_at)
         VALUES ($1, $2, 'member.invited', $2, $3::timestamptz)`,
        [tenantA, accountA, sharedTs],
      );
    });

    const page1 = await withTenantScope(tenantA, async (client) =>
      auditLogService.list(
        client, tenantA,
        new Date('2026-05-21T00:00:00Z'),
        new Date('2026-05-22T00:00:00Z'),
        { limit: 1 },
      ),
    );
    expect(page1.entries.length).toBe(1);

    const page2 = await withTenantScope(tenantA, async (client) =>
      auditLogService.list(
        client, tenantA,
        new Date('2026-05-21T00:00:00Z'),
        new Date('2026-05-22T00:00:00Z'),
        { limit: 1, cursor: page1.nextCursor ?? undefined },
      ),
    );
    expect(page2.entries.length).toBe(1);
    expect(page2.entries[0].id).not.toBe(page1.entries[0].id);
  });

  it("filters out rows that don't match the human-only predicate", async () => {
    await withTenantScope(tenantA, async (client) => {
      await client.query(
        `INSERT INTO audit_log (id, event_type, timestamp, tenant_id, resource_type, resource_id, action)
         VALUES ('bg-1', 'system.task', NOW(), $1, 'system', $1, 'task')`,
        [tenantA],
      );
      await client.query(
        `INSERT INTO internal_agent_audit (tenant_id, action, changes, created_at)
         VALUES ($1, 'archived', '{}'::jsonb, NOW())`,
        [tenantA],
      );
      await client.query(
        `INSERT INTO agent_audit_logs (tenant_id, action, triggered_by, outcome, input_args, created_at)
         VALUES ($1, 'tool.call', 'agent:11111111-1111-1111-1111-111111111111', 'success', '{}'::jsonb, NOW())`,
        [tenantA],
      );
    });

    const result = await withTenantScope(tenantA, async (client) =>
      auditLogService.list(
        client, tenantA,
        new Date('2026-05-20T00:00:00Z'),
        new Date('2026-05-22T00:00:00Z'),
        {},
      ),
    );
    expect(result.entries).toHaveLength(0);
  });

  it('surfaces human-triggered agent_audit_logs rows (corrections from /review)', async () => {
    await withTenantScope(tenantA, async (client) => {
      for (const action of ['correction_request', 'correction_approved', 'correction_rejected']) {
        await client.query(
          `INSERT INTO agent_audit_logs (tenant_id, action, triggered_by, outcome, input_args, created_at)
           VALUES ($1, $2, 'human:' || $3, 'success', '{}'::jsonb, NOW())`,
          [tenantA, action, accountA],
        );
      }
    });

    const result = await withTenantScope(tenantA, async (client) =>
      auditLogService.list(
        client, tenantA,
        new Date('2026-05-20T00:00:00Z'),
        new Date('2026-05-22T00:00:00Z'),
        {},
      ),
    );
    const actions = result.entries
      .filter((e) => e.id.startsWith('agent_audit_logs:'))
      .map((e) => e.action);
    expect(actions).toEqual(
      expect.arrayContaining([
        'correction_request',
        'correction_approved',
        'correction_rejected',
      ]),
    );
  });
});
