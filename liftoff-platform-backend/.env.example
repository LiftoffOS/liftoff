# Liftoff Platform Backend - Environment Variables
# Copy this file to .env and fill in the values

# ==============================================================================
# REQUIRED - Core Configuration
# ==============================================================================

| Variable | Required | Description |
|----------|----------|-------------|
# DATABASE_URL          | Yes | PostgreSQL connection string
# GCP_PROJECT_ID        | Yes | GCP project ID for this environment
# ENVIRONMENT           | Yes | Environment name (dev, staging, prod)

DATABASE_URL=postgresql://postgres:password@localhost:5432/liftoff_control
GCP_PROJECT_ID=YOUR_CONTROL_PROJECT_STAGING
ENVIRONMENT=dev

# Admin DB user with BYPASSRLS privilege (for cross-tenant operations)
# Created by migration 090. Falls back to DB_USER if not set.
DB_ADMIN_USER=liftoff_admin

# Admin-pool BYPASSRLS startup probe — OPT-IN enforcement.
# Set to the literal string 'true' to make the probe throw at startup when
# the admin-pool role lacks BYPASSRLS. By default the probe only logs a
# warning (Cloud Run sets NODE_ENV=production for every environment, so
# auto-detection isn't a viable signal). Set this once FORCE ROW LEVEL
# SECURITY is rolled out per the operator playbook in docs/rls-todo.md.
# Strict match: only the value 'true' is accepted (matches repo convention).
# LIFTOFF_REQUIRE_ADMIN_BYPASSRLS=true

# ==============================================================================
# OPTIONAL - Authentication
# ==============================================================================

# Firebase service account credentials (JSON string). Only needed for local
# development when you don't have ADC set up. In Cloud Run (dev + prod), the
# Firebase Admin SDK initializes via Application Default Credentials — the
# runtime service account, which has roles/firebase.admin on YOUR_WEB_PROJECT.
# For local dev, prefer: gcloud auth application-default login.
FIREBASE_SERVICE_ACCOUNT=

# ==============================================================================
# REQUIRED - Stripe Billing
# ==============================================================================

# The prepaid floor, in USD (default 2). A pre-pay workspace past its plan's
# allowance stops being admitted to new work once its reload balance is under
# this, before the balance is gone: spend reaches the balance minutes after
# it happens (the ingest run), so a workspace admitted on its last cent
# spends the platform's money for those minutes. See billing/prepaid-floor.ts.
# PREPAID_SPEND_FLOOR_USD=2

# Stripe API keys for billing integration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ==============================================================================
# REQUIRED - URLs
# ==============================================================================

# Public URL of this backend service
BACKEND_URL=http://localhost:8080

# Public URL of the frontend application. REQUIRED, with no default: every link
# this service sends a person (email, notification, share link) is built from it,
# and a default would mint well-formed links against a host this deployment does
# not own — which reaches nothing and reports nothing.
FRONTEND_URL=http://localhost:5173

# ==============================================================================
# OPTIONAL - Billing provider
# ==============================================================================
# Which billing system decides provisioning: 'stripe' or 'unbilled'.
#
# Unset is detected: Stripe when STRIPE_SECRET_KEY is present, unbilled
# otherwise. So a deployment that holds no Stripe account needs nothing here —
# accounts are created with no customer record, a workspace may run work the
# moment it is activated, and no suspended billing_controls row is seeded.
#
# Metering, the Operating Unit buckets and the admission chain are unaffected
# either way: an unbilled deployment still meters and still reports, it simply
# never has a charge to make.
# BILLING_PROVIDER=unbilled

# ==============================================================================
# REQUIRED - Outbound email identity
# ==============================================================================
# Mail is sent through Resend (RESEND_API_KEY, in Secret Manager or the
# environment). A provider will only sign mail for a domain its own account has
# verified, so the From address cannot be defaulted: with MAIL_FROM_ADDRESS
# unset every send fails, which means no invitation, no password reset and no
# signup approval.
#
# Verify your domain with the provider first (Resend: Domains -> Add Domain),
# then set an address on it.
MAIL_FROM_ADDRESS=noreply@yourdomain.com

# Display name on outbound mail. Optional; defaults to "Liftoff".
# MAIL_FROM_NAME=Liftoff

# Where replies go. Optional; defaults to MAIL_FROM_ADDRESS, which is better
# than a support mailbox nobody in this deployment reads.
# MAIL_REPLY_TO_ADDRESS=support@yourdomain.com

# Who gets told when somebody signs up. Optional, and leaving it unset is a
# supported choice: the notification is skipped rather than sent somewhere
# arbitrary, and the /signup-approval page still decides access either way.
# MAIL_SIGNUP_NOTIFICATION_ADDRESS=signups@yourdomain.com

# ==============================================================================
# OPTIONAL - Who may sign in
# ==============================================================================
# Comma-separated email domains allowed to sign up, overriding both Firebase
# Remote Config and the built-in default. Unset means any domain, which is what
# a single-workspace install wants; a list naming a domain nobody here owns
# locks every account out with a 403 on every route.
# ALLOWED_DOMAINS=yourdomain.com,partner.example

# Comma-separated domains whose accounts are flagged as internal staff of this
# deployment. Empty by default - nobody is flagged, which is the honest answer.
# INTERNAL_EMAIL_DOMAINS=yourdomain.com

# URL of the Tenant Runtime service (for cross-service calls)
TENANT_RUNTIME_URL=http://localhost:4000

# ==============================================================================
# REQUIRED - OAuth Provider Credentials
# ==============================================================================
# These are used for connector OAuth flows
# Client IDs and secrets for each OAuth provider

# Google Workspace
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Liftoff Slack app identity (ADR-040) — ONE app per environment serving the
# connector AND the workspace bot; the install is the slack connector connect
# (dual-grant OAuth in connector-service, bot token delivered via
# /api/internal/agent-slack/workspace-install). This service only needs the
# app id (webhook/interactivity fork discriminator) and signing secret —
# same Secret Manager values connector-service binds as SLACK_APP_ID /
# SLACK_SIGNING_SECRET (slack-app-id-{env} / slack-oauth-signing-secret-{env}),
# bound in Terraform. Unset ⇒ the workspace surface is disabled.
# Setup: docs/runbooks/SLACK_WORKSPACE_APP_SETUP.md
LIFTOFF_SLACK_APP_ID=
LIFTOFF_SLACK_SIGNING_SECRET=

# GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Atlassian (Jira, Confluence)
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=

# Salesforce
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Zendesk
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=

# Dropbox
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=

# Box
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=

# Zoom
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Stripe Connect
STRIPE_CONNECT_CLIENT_ID=

# Intercom
INTERCOM_CLIENT_ID=
INTERCOM_CLIENT_SECRET=

# ==============================================================================
# DCR OAuth Providers (local dev fallback only — DO NOT set in production)
# ==============================================================================
# These connectors use RFC 7591 Dynamic Client Registration at runtime.
# In production, oauth-discovery.ts discovers endpoints and registers a client
# dynamically — NO pre-registered CLIENT_ID or CLIENT_SECRET is needed or wanted.
# Setting these in production will silently disable the DCR flow.
#
# For local dev only: set these to bypass discovery and test with a manually-
# created app on the vendor's dev portal.

# Linear (DCR — mcp.linear.app/mcp)
# LINEAR_CLIENT_ID=
# LINEAR_CLIENT_SECRET=

# Notion (DCR — mcp.notion.com/mcp)
# NOTION_CLIENT_ID=
# NOTION_CLIENT_SECRET=

# Asana (DCR — mcp.asana.com/v2/mcp)
# ASANA_CLIENT_ID=
# ASANA_CLIENT_SECRET=

# PayPal (DCR — mcp.paypal.com/sse)
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# Calendly (DCR — mcp.calendly.com/mcp)
# CALENDLY_CLIENT_ID=
# CALENDLY_CLIENT_SECRET=

# Datadog (DCR — mcp.datadoghq.com/api/unstable/mcp-server/mcp)
# DATADOG_CLIENT_ID=
# DATADOG_CLIENT_SECRET=

# ==============================================================================
# Active — Static OAuth providers (requires vendor app registration)
# ==============================================================================

# Intuit (QuickBooks Online) — Register at developer.intuit.com
# INTUIT_CLIENT_ID=
# INTUIT_CLIENT_SECRET=

# Xero — Register at developer.xero.com
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=

# ==============================================================================
# Active — No platform env vars required (user provides credentials at connect time)
# ==============================================================================

# Snowflake — keypair auth (RSA key generated server-side, user pastes public key into Snowflake)
# No env vars needed — user provides accountIdentifier + username at connect time

# Databricks — PAT auth (user provides workspace URL + Personal Access Token)
# No env vars needed — user provides workspaceUrl + patToken at connect time

# Square — Register at developer.squareup.com
# SQUARE_CLIENT_ID=
# SQUARE_CLIENT_SECRET=

# Pipedrive (API key connector — user provides key, no platform registration needed)
# No env vars required

# DocuSign — Register at developers.docusign.com
# DOCUSIGN_CLIENT_ID=
# DOCUSIGN_CLIENT_SECRET=

# Gusto (requires partner approval at gusto.com/embedded-payroll)
# GUSTO_CLIENT_ID=
# GUSTO_CLIENT_SECRET=

# Rippling (requires partner approval at developer.rippling.com)
# RIPPLING_CLIENT_ID=
# RIPPLING_CLIENT_SECRET=

# ==============================================================================
# REQUIRED - LLM Configuration (at least one model key)
# ==============================================================================
# Every key in this block is individually optional and the block as a whole is
# not: `LLMClient` builds one provider per key it finds and throws
# "No LLM providers available. At least one provider must be configured."
# when it finds none. There is nothing to fall back to — the AI teams, the three
# platform assistants, distillation, tool classification and the injection guard
# all run on these.
#
# This is the deployment's OWN key, and it is a different question from the
# per-workspace keys under "BYO AI provider keys" below. Those fund a
# customer-initiated, chargeable call through the /byok gateway; this one funds
# the platform's own work, which no customer key is ever asked to pay for.
#
# Each key resolves env var first, then a Secret Manager secret of the same
# name in GCP_PROJECT_ID (`anthropic-api-key`, `openai-api-key`, …), so a
# deployment may set either and needs no code change for either.

# OpenAI API key (for tool classification, distillation)
OPENAI_API_KEY=

# Anthropic API key (direct API access)
ANTHROPIC_API_KEY=

# Anthropic ORGANISATION admin credential, for the nightly billing reconciler
# only. The usage and cost reports live on the Admin API; the message keys above
# return 401 against them. Accepts an admin API key (sk-ant-admin...) or an OAuth
# token. Unset is supported: the reconciler then records our own side and says
# the vendor side is missing.
ANTHROPIC_ADMIN_KEY=

# Anthropic reports usage against the API key ID, never the secret, so the
# mapping from key ID to purpose group has to be stated. Find the IDs in the
# Anthropic Console (they look like apikey_01...). Unset means that group's
# vendor tokens cannot be attributed and its token comparison is skipped.
ANTHROPIC_API_KEY_ID_AGENT_EXECUTION=
ANTHROPIC_API_KEY_ID_BACKGROUND_SERVICES=
ANTHROPIC_API_KEY_ID_PLATFORM_ANALYTICS=
ANTHROPIC_API_KEY_ID_REFLECTIVE_SERVICES=

# Z.ai / GLM (open-weights, OpenAI-wire). Reached via OpenRouter by default, or
# Vertex AI Model Garden with ADC. See docs/adr/029-zai-glm-open-weights-provider.md.
#   OPENROUTER_AUTH_MODE       'openrouter' (default) | 'adc' (Vertex Model Garden, in-GCP)
#   OPENROUTER_API_KEY  OpenRouter key (openrouter-api-key secret in prod); required when OPENROUTER_AUTH_MODE=openrouter
#   OPENROUTER_BASE_URL        override the OpenAI-wire base URL (default OpenRouter; point at self-hosted vLLM/SGLang)
#   OPENROUTER_CODE_MODEL      GLM model for the code_session zai runner (default z-ai/glm-5.2)
# The OpenRouter-served Workspace AI vendors (GLM / Qwen / DeepSeek / Kimi / Grok)
# all execute under provider 'openrouter' and share the key above; they are
# distinguished by model id and by their registry-side provider key.
# Pricing sync (model-pricing-sync Cloud Run Job → model_pricing table):
#   MODEL_PRICING_MARGIN  optional multiplier applied to synced OpenRouter rates (default 1.0)
#   OPENROUTER_API_BASE   OpenRouter API root for the pricing sync (default https://openrouter.ai/api/v1)
OPENROUTER_AUTH_MODE=openrouter
OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=
# OPENROUTER_CODE_MODEL=z-ai/glm-5.2
# MODEL_PRICING_MARGIN=1.0
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# ==============================================================================
# OPTIONAL - Knowledge Retrieval
# ==============================================================================

# Enables hybrid retrieval for the agent corpus_search tool. When set to
# 'true' (or '1' / 'on'), every POST /api/internal/knowledge/search embeds
# the query via OpenAI text-embedding-3-small (background-services key) and
# Reciprocal Rank Fusion combines BM25 with cosine similarity against the
# knowledge_items.embedding column. Off by default → BM25 only (no per-search
# embedding latency or API spend). The embedding worker
# (jobs/embed-knowledge-content.ts) runs regardless of this flag; the flag
# only controls whether the search path uses the embeddings the worker writes.
KNOWLEDGE_HYBRID_RETRIEVAL_ENABLED=

# ==============================================================================
# OPTIONAL - Passkey/WebAuthn
# ==============================================================================

# Relying Party ID for WebAuthn (domain name)
PASSKEY_RP_ID=localhost

# Expected origin for WebAuthn verification
PASSKEY_ORIGIN=http://localhost:5173

# ==============================================================================
# OPTIONAL - Service Communication
# ==============================================================================

# Service token for authenticated calls from Tenant Runtime
TENANT_RUNTIME_SERVICE_TOKEN=

# Callback token for Tenant Runtime → Platform Backend calls
# (e.g., find_teammates MCP tool). Separate from TENANT_RUNTIME_SERVICE_TOKEN
# for blast-radius isolation. Must match PLATFORM_CALLBACK_TOKEN on the TR side.
# Also gates the notifications internal endpoints (enqueue, run-tick, newsletter)
# and the hourly Cloud Scheduler tick.
PLATFORM_CALLBACK_TOKEN=

# HMAC key for signing unsubscribe URLs. Random 32+ bytes (hex or base64).
# Tokens have a 90-day TTL; rotate this only with the understanding that all
# in-the-wild unsubscribe links will be invalidated immediately.
UNSUBSCRIBE_SECRET=

# Master kill switch for notification email delivery.
# Default unset/'false' = enqueueNotification short-circuits before inserting
# rows or sending mail. Flip to 'true' in Cloud Run env ONLY after the FE
# GlobalUnsubscribeHandler is live in prod, otherwise unsubscribe links 404.
NOTIFICATION_DELIVERY_ENABLED=false

# Enable Tenant Runtime integration features
ENABLE_TENANT_RUNTIME=false

# Shared bearer token recognised on cross-service calls from
# liftoff-workforce-service back into platform-backend (system-agent config
# fetch, internal-agent create, agent-audit-logs write). Workforce-service
# sources the same value from the `workforce-service-token` Secret Manager
# secret. One secret, two views.
WORKFORCE_SERVICE_TOKEN=

# ==============================================================================
# OPTIONAL - Connector Service (Phase 1c — platform decomposition)
# ==============================================================================

# Base URL of the extracted liftoff-connector-service.
CONNECTOR_SERVICE_URL=http://localhost:8080

# Shared X-Service-Auth token used by platform-backend → connector-service.
# Rotated via Secret Manager in prod.
CONNECTOR_SERVICE_TOKEN=

# Shared X-Service-Auth token used by harvest-service → platform-backend
# internal LLM relay. Rotated via Secret Manager in prod.
HARVEST_SERVICE_TOKEN=

# Shared X-Service-Auth token used by tenant-runtime's slack-tool-handler
# → platform-backend /api/internal/agent-slack/* RPC. Tenant-runtime carries
# this token on every per-agent Slack install lookup and channel-binding read.
# Rotated via Secret Manager in prod.
AGENT_SLACK_SERVICE_TOKEN=

# Shadow-mode rollout flag. Values: off (default) | shadow | on
#   off    — connector-service not called; legacy in-process path owns the work.
#   shadow — both paths execute; responses compared, legacy path serves the
#            user. Used for 48h validation before flipping to `on`.
#   on     — connector-service owns the path; legacy path is dormant (and
#            removed in Phase 2).
CONNECTOR_SERVICE_ENABLED=off

# Pub/Sub subscription name for inbound audit events from governance-engine.
# Unset in local dev — audit events written locally only.
AUDIT_EVENTS_SUBSCRIPTION=

# ==============================================================================
# OPTIONAL - Cloud Storage
# ==============================================================================

# GCS bucket for generated artifacts: documents an agent authored, browser
# snapshots and downloads, and the media people attach or agents show.
#
# REQUIRED, and deliberately without a default in code. It used to default to
# the dev bucket's literal name, so an unset value in production silently read
# and wrote DEV's storage. Terraform sets it from the bucket resource
# (platform-control/generated-files-bucket.tf) in each environment.
GENERATED_FILES_BUCKET=YOUR_GCP_PROJECT

# GCS bucket for data exports (GDPR)
EXPORT_BUCKET=exports

# GCS bucket for compliance evidence
EVIDENCE_BUCKET=compliance-evidence

# GCS bucket for database backups
BACKUP_BUCKET=db-backups

# ==============================================================================
# OPTIONAL - Disaster Recovery
# ==============================================================================

# Cloud SQL instance name for restore drills
CLOUD_SQL_INSTANCE=control-plane-pg-dev

# Cloud Run job name for restore testing
RESTORE_JOB_NAME=dr-restore-drill

# ==============================================================================
# OPTIONAL - Multi-Tenancy
# ==============================================================================

# Enable shared-tier tenancy (Phase 2). Must be false until RLS is verified in production.
SHARED_TENANCY_ENABLED=false

# Shared runtime GCP project (used for shared-tier secret storage)
# SHARED_RUNTIME_PROJECT=YOUR_TENANT_PROJECT

# Shared runtime URL (for shared-tier tenants)
# SHARED_RUNTIME_URL=https://tenant-runtime-liftoffos-dev.run.app

# GCP project hosting the SHARED runtime pool. Shared-tier tenants carry no
# gcp_project_id of their own (that column marks the dedicated tier), so this is
# the project whose service accounts are allowed to act for them. Change this one
# value when the shared pool moves to a purpose-built project.
SHARED_RUNTIME_PROJECT_ID=YOUR_TENANT_PROJECT

# ==============================================================================
# OPTIONAL - Monitoring
# ==============================================================================

# GCP region for resource deployment
GCP_REGION=us-west1

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# ==============================================================================
# OPTIONAL - Distill Rate Limiting (Phase 5)
# ==============================================================================

# Max distill requests per tenant per minute
# DISTILL_RATE_LIMIT_TENANT_PER_MINUTE=10

# Max distill requests per user per minute
# DISTILL_RATE_LIMIT_USER_PER_MINUTE=5

# The distiller's patch rung: a medium-tier call that edits the named fields
# of a rejected workflow graph before the whole artifact is regenerated on
# the large tier (src/internal-agents/distill-patch.ts). On by default in every
# environment: it is fail-closed (a patch that does not converge, breaks
# scope, returns nothing or throws falls through to the regeneration exactly
# as before) and its properties are proven by distill-patch.test.ts and
# distill-patch-closure.test.ts. Set to 0 only for a code defect in the rung;
# it is not a cost dial, and no measurement decides it. The patch calls are
# recorded in distill_runs (phase 'patch') for anyone who wants to read them.
# DISTILL_PATCH_ENABLED=1

# ==============================================================================
# OPTIONAL - TypeSafe (the Jev classifier, src/typesafe/)
# ==============================================================================

# The vendor key. Env var first, then Secret Manager `typesafe-api-key` in
# GCP_PROJECT_ID. Missing means no request is sent and no usage row is written:
# every caller takes today's path, which for three of the four call sites is a
# model call that does the same job less cheaply.
#
# ONE CONSEQUENCE IS NOT A FALLBACK. `effect_class` is produced by the Jev head
# alone (src/mcp/tool-classifier.ts, effectClassFromBands); the generation and
# keyword rungs below it return categories and no effect class. So with no key
# every custom MCP server's and every external collaborator's tools are stored
# with a NULL effect class and report as UNSPECIFIED to the runtime —
# permanently, not until a retry. Sensitivity categories are unaffected.
#
# The SDK is public (@typesafe-ai/sdk on npmjs) and the host is the vendor's own
# API. Nothing here is account-scoped: the set ids below are local labels that
# are never sent, and every decision definition — questions, criteria,
# thresholds — is in src/typesafe/questions.ts. A key from any TypeSafe account
# works, provided the model pinned in that file is available to it.
TYPESAFE_API_KEY=

# Kills, not flags: each one is the switch for a code defect in one item and
# defaults on; 0 is today's path exactly. None is a cost dial.
#
# The tool classifier (Phase 1) and the effect class it carries to the
# governance engine (1b). Off: Opus classifies as before, no new effect_class
# is written, and both custom-MCP endpoints report the version segment `off`
# so the runtime refetches every entry with no effect class appended.
# TYPESAFE_CLASSIFIER_ENABLED=1
# The distiller's bind rung (Phase 3), BOTH branches: the deterministic
# exact/alias rebind and the Jev disambiguation among fuzzy candidates.
# DISTILL_BIND_ENABLED=1
# The `suggested` routing rung (Phase 9) on Slack, Teams and the dashboard's
# multi-agent threads. Off: the picker and the ILIKE rung, as today.
# TYPESAFE_ROUTING_ENABLED=1
# The prompt-injection screen's Jev rung. Off: the medium-tier model screens
# every message instead, as it did before. Note that the guard itself fails
# OPEN on a classifier outage (src/common/injection-guard.ts) — "could not
# decide" and "decided it is safe" are the same value to its caller — so this
# switch changes which classifier runs, never whether a message is screened.
# TYPESAFE_INJECTION_GUARD_ENABLED=1

# ==============================================================================
# OPTIONAL - Claude Code Proxy
# ==============================================================================

# Base URL for the proxy (used in setup instructions shown to users)
# PROXY_BASE_URL=https://api.example.com/proxy

# ==============================================================================
# OPTIONAL - Liftoff Switch (source imports)
# ==============================================================================

# The official MCP Registry, read-only and unauthenticated. An imported stdio
# MCP server is resolved against it to decide whether the capability already
# exists here as a connector or as an endpoint the vendor hosts. Unreachable is
# INCONCLUSIVE, never blocking: the import keeps the Requires hosting card.
# Override only to point at a mirror or a test double.
# MCP_REGISTRY_BASE_URL=https://registry.modelcontextprotocol.io

# ==============================================================================
# OPTIONAL - Platform-funded public web data collection (Apify)
# ==============================================================================

# The platform's own Apify account token (apify-platform-token secret). With it
# set, a public Store automation that capability discovery surfaces can be run
# for a workspace on this account, and the run is booked to the workspace by
# its run id. Unset, Store automations are not offered as runnable at all —
# nothing pretends otherwise. ONE account serves every environment, so runs of
# the same automation overlap routinely; everything about a run is keyed by the
# id the start call returns (src/capability-discovery/apify-executor.ts).
# APIFY_PLATFORM_TOKEN=
# The most one actor run may charge, in USD, sent as maxTotalChargeUsd on
# every start call (Apify stops the run at the cap). The account has no
# auto-reload, so a single runaway actor must not be able to drain it. Default
# 1; the largest run booked to date is $0.76. A run on a PREPAID TOKEN is
# capped at the token's remaining balance when that is less: Apify does NOT
# stop a run at a token's balance, and one that was handed three runs finished
# at -$0.22 against a dollar of credit.
# APIFY_MAX_RUN_CHARGE_USD=1
# Apify prepaid tokens are bought through Locus — Apify has no per-run rail on
# any rail, and Locus's one Apify entry buys the same token — always for $1,
# which is the monthly hard limit of the Apify account each token IS. Set this
# to 1 to let the x402 wallet buy one when LOCUS COULD NOT: an emergency lever,
# off by default, and every purchase it allows is logged at error level
# (`apify_prepaid_wallet_fallback_used`).
# APIFY_PREPAID_WALLET_FALLBACK=0
# How many prepaid tokens may be bought per UTC day, counted from the table.
# Default 2.
# APIFY_PREPAID_MAX_PURCHASES_PER_DAY=2
# Below this balance in USD a prepaid token is spent: no run takes it and the
# next one is bought. Default 0.1.
# APIFY_PREPAID_MIN_BALANCE_USD=0.1
# To take the vendor out of service without touching the key, use the admin
# connector kill switch on `apify` (docs/admin-api.md), which the capability
# path honours at the offer step and at execution. The platform ACCOUNT parks
# itself under `internal:apify:platform-account` when Apify answers its
# monthly hard limit, which leaves the prepaid tokens running.

# ==============================================================================
# OPTIONAL - BYO AI provider keys (the /byok gateway)
# ==============================================================================

# Upstream origins the gateway forwards a customer's own credential to.
# Unset in every real environment: the defaults ARE the vendors. Overriding one
# points that vendor at a stub, which is only useful for a local end-to-end run.
# BYOK_ANTHROPIC_BASE_URL=https://api.anthropic.com
# BYOK_OPENAI_BASE_URL=https://api.openai.com
# BYOK_XAI_BASE_URL=https://api.x.ai
#
# Google has no fixed origin to override. A customer's Google credential is a
# Vertex AI service account, and Vertex serves from a per-LOCATION host derived
# from that credential ({location}-aiplatform.googleapis.com, or the bare host
# for `global`). BYOK_GOOGLE_BASE_URL is read only as the fallback origin when
# nothing has been resolved yet.
# BYOK_GOOGLE_BASE_URL=https://aiplatform.googleapis.com
#
# The google door also serves the GEMINI DEVELOPER API's request grammar, not
# only Vertex's, and translates it (byok-gateway/google-path.ts). Nothing to
# configure; it is here because the two clients that can only be handed a base URL
# and a key — the Gemini CLI and the coding runner — speak that grammar, and
# untranslated it 404s at Vertex in a way that reads like a bad model id.
#
# THE FIFTH DOOR HAS NO ENV OF ITS OWN. `/byok/openrouter` exists for MANAGED
# sessions only — an OpenRouter invoice is Liftoff's, so no customer key can fund
# one and the keys card offers no field for it. It is what lets the open-weights
# families (GLM, Qwen, DeepSeek, Kimi, MiniMax, Xiaomi) have their reasoning tokens
# read off the wire, which their engine's own summary does not report. Its upstream
# is OPENROUTER_BASE_URL, the same override the rest of the estate's OpenRouter
# traffic uses, so pointing that at a self-hosted vLLM or SGLang host moves both
# together — which is the intended behaviour, and the door keeps the vendor's
# `v1/` segment when the base does not carry one.

# The gateway's own public address is derived from BACKEND_URL — it is
# ${BACKEND_URL}/byok/{vendor}, handed to the runtime as an SDK base URL. There
# is no separate variable for it, deliberately: a second source for the same
# host is how a dev deployment ends up handing out prod URLs.
#
# There is no BYOK credential variable of any kind. A customer's key lives in
# Secret Manager as ai-provider-key-{tenantId}-{vendor} and is never an
# environment value — and for Google what is stored is a service account, which
# the gateway exchanges for a short-lived token per request rather than sending.

# ==============================================================================
# OPTIONAL - Developer Proxy Service (liftoff-developer-proxy)
# ==============================================================================

# Base URL of the extracted liftoff-developer-proxy service.
# Set to 'new' to delegate credential management and proxy traffic to the service.
# DEVELOPER_PROXY_SERVICE_URL=http://localhost:3004
# DEVELOPER_PROXY_SERVICE_ENABLED=new
# DEVELOPER_PROXY_WEBHOOK_TOKEN_SECRET=

# ==============================================================================
# OPTIONAL - Cost Attribution
# ==============================================================================

# Fully-qualified BigQuery table reference for GCP billing export.
# Format: project.dataset.table  (e.g. YOUR_CONTROL_PROJECT.billing_export.gcp_billing_export_prod)
# Only one BigQuery billing export is allowed per GCP billing account.
# Configured for prod only — leave unset in dev (gcp-billing-ingester skips silently).
# GCP_BILLING_SHARED_BQ_DATASET=

# One-shot historical backfill: ISO timestamp for the start of the backfill window.
# Only used when running backfill-runner.ts manually or as a Cloud Run Job.
# BACKFILL_SINCE=2024-01-01T00:00:00Z

# Comma-separated list of ingesters to include in the backfill run.
# Defaults to all 6 ingesters when not set.
# BACKFILL_INGESTERS=platform_llm,runtime,sandbox,governance,developer_proxy,gcp_billing

# ==============================================================================
# OPTIONAL - Slack Agent Apps (per-agent Slack identity via Manifest API)
# ==============================================================================

# GCP Secret Manager secret name for the Slack config token refresh token.
# Used to create/update/delete per-agent Slack apps.
# One-time setup: generate config token at api.slack.com/apps, store refresh
# token in Secret Manager.
# SLACK_CONFIG_REFRESH_TOKEN_SECRET_NAME=slack-config-refresh-token

# Backend URL for Slack OAuth callbacks and event webhook URLs.
# Defaults to https://api.example.com if not set.
# BACKEND_URL=https://api.example.com


# Workflow engine internal callback auth — HMAC-SHA256 shared secret.
# Tenant Runtime presents this token when calling /api/internal/workflow/step-completed.
# WORKFLOW_INTERNAL_TOKEN=generate-a-random-secret

# ==============================================================================
# OPTIONAL - Pre-pay Billing Mode
# ==============================================================================

# Default billing mode for new accounts: 'pre_pay' | 'post_pay'.
# Defaults to 'pre_pay' if unset (matches subscription-activated, which always
# sets billing_mode='pre_pay' for both self-serve and enterprise subscriptions).
# Override per-request via the /init body's `billingMode` field, or set this
# env var + redeploy to flip the default for the rarely-used post_pay path.
BILLING_DEFAULT_MODE=pre_pay

# Gate for the annual plan monthly allocation reset Cloud Scheduler job, which
# grants an annual subscriber every allowance after their first. Deployed
# environments set this to 'true' in Terraform on the platform_backend module;
# false here because a local box has no scheduler to pair it with. The endpoint
# refuses with 503 when it is not 'true', so turning it off in a deployed
# environment means pausing that environment's scheduler job as well.
ANNUAL_ALLOCATION_RESET_ENABLED=false

# ==============================================================================
# OPTIONAL - Agent test harness
# ==============================================================================

# X-Service-Auth token accepted by POST /api/internal/test-harness/run-chat.
# Optional — if unset, the harness route also accepts TENANT_RUNTIME_SERVICE_TOKEN
# (src/test-harness/run-chat-router.ts).
# TEST_HARNESS_SERVICE_TOKEN=

# ==============================================================================
# OPTIONAL - Canonical connector secret storage
# ==============================================================================

# Hosting model for canonical connector secret storage: 'shared' | 'dedicated'.
# Defaults to 'shared' (src/connectors/canonical-secret-storage.ts).
# TENANT_HOSTING_MODE=shared

# GCP project that holds a tenant's secrets when hosting mode is 'dedicated'.
# Defaults to `tenant-${tenantId}-${env}` if unset.
# TENANT_GCP_PROJECT_ID=

# MCP OAuth front door (plan v6.1). false = legacy behavior: .well-known 404s
# and /mcp omits the WWW-Authenticate challenge. Flip to true per environment
# as the Phase 6 release gate.
MCP_OAUTH_ENABLED=false

# ==============================================================================
# OPTIONAL - Semantic conversation recall (v2)
# ==============================================================================

# Gates the turn-content embedding WRITE path: the best-effort inline embed in
# chat-service AND the embed-sweep-chat-turns job (the job reads its OWN copy
# of this env var — job env is separate from service env; both live in the
# infra repo Terraform). BILLING NOTE: enabling this starts embedding spend
# (classified platform_overhead via purpose 'conversation_recall').
RECALL_EMBED_WRITE_ENABLED=false

# Gates the endpoint's semantic READ branch (keyword-first short-circuit:
# query embeddings run — and are customer-attributed via purpose
# 'conversation_recall_query' — only when keyword retrieval under-fills the
# requested limit). Rollback is flipping this to false.
RECALL_SEMANTIC_READ_ENABLED=false

# Transport deadline for query-time embeddings, in ms. Bounded to (0, 30000];
# out-of-range or unset uses the 2500 default (one healthy provider round
# trip; negligible vs the 5-minute chat-turn budget).
RECALL_QUERY_EMBED_DEADLINE_MS=2500

# Chat-turn Cloud Tasks worker (ADR-041): OIDC identity of chat-turns-{env} queue
# deliveries; the worker endpoint pins the token email to this SA. Set by
# Terraform on Cloud Run; local dev uses the x-internal-secret fallback instead.
# CHAT_TURNS_INVOKER_SA=chat-turns-invoker@<project>.iam.gserviceaccount.com

# ── Composio quota governance ───────────────────────────────────────────
# Composio bills ONE organization-wide meter across every tenant, agent and
# endpoint. These are the FREE-TIER limits verified 2026-08-07; change them
# here (not in code) when a paid tier is bought. The control plane reads
# cost_attribution_events (source='composio_mcp') to meter consumption and
# hands each tenant runtime a slice via
# GET /api/internal/platform-tools/composio-quota.
COMPOSIO_ORG_MONTHLY_QUOTA=20000
COMPOSIO_ORG_PER_MINUTE_LIMIT=100

# Monthly calls held back for FOREGROUND work only. Background work — a
# scheduled run, a connector event, anything with nobody waiting — is refused
# once the remaining quota falls to this. A person asking for something is not.
COMPOSIO_MONTHLY_RESERVED_HEADROOM=2000

# Fraction of the spendable quota (quota minus reserve) carved into per-tenant
# GUARANTEED slices; the remainder is a shared burst pool any tenant may draw
# on after spending its slice. 1.0 = hard partitioning, 0.0 = one shared pool.
COMPOSIO_GUARANTEED_FRACTION=0.5

# Floor on a tenant's per-minute share so a large fleet does not divide the org
# ceiling into a rate no agent turn can finish under. Always clamped to
# COMPOSIO_ORG_PER_MINUTE_LIMIT — a tenant is never allowed to exceed what the
# whole organization is allowed.
COMPOSIO_MIN_TENANT_PER_MINUTE=10

# How long a runtime may serve a cached allocation before refreshing.
COMPOSIO_ALLOCATION_TTL_MS=300000

# ==============================================================================
# OPTIONAL - MCP tunnels (only if a workspace exposes a local MCP server)
# ==============================================================================
# Both have NO DEFAULT and the tunnel service throws without them, because both
# end up in front of a customer: the domain becomes the hostname their tunnel is
# published on, and the image is what they are told to `docker run`. A default
# would hand somebody a hostname on a domain this deployment does not control,
# and a pull from a registry account it does not own. Leaving them unset is
# fine — nothing throws until a tunnel is actually created.

# Wildcard domain this deployment controls and can serve TLS for. A tunnel is
# published at https://{prefix}-{subdomain}.{TUNNEL_BASE_DOMAIN}.
# TUNNEL_BASE_DOMAIN=tunnels.example.com

# The tunnel-client image this deployment publishes, with a tag.
# TUNNEL_CLIENT_IMAGE=ghcr.io/you/tunnel-client:1.0.0

# Where the tunnel-client polls for its config. Defaults to BACKEND_URL, which
# is almost always right; set it only when the client must reach the API on a
# different address than the rest of the platform uses.
# TUNNEL_API_BASE_URL=

# ---------------------------------------------------------------------------
# Deletion and retention
# ---------------------------------------------------------------------------
# Deleting an account, an AI team, an external collaborator or a conversation
# happens in two steps. The row is marked straight away, which removes it from
# every read, list and export; it is hard-deleted once the grace period below
# has elapsed, by a purge pass that runs inside this service. Deleting an
# account is the one exception: that path cascades immediately, because it
# also has to revoke third-party OAuth grants, delete the sign-in identity and
# strip the billing customer.
#
# How many days a deleted row survives before it is removed for good. The
# grace period exists so an operator can undo a mistake; shorter is a stronger
# privacy posture. Values below 1 are refused and 30 is used instead, because
# purging before the person has finished reading the confirmation turns a
# misclick into unrecoverable loss.
# SOFT_DELETE_PURGE_AFTER_DAYS=30

# How often the purge pass runs, in hours. Twice a day by default. Running it
# on several instances is safe: the pass takes a Postgres advisory lock, so
# only one runs at a time.
# SOFT_DELETE_PURGE_INTERVAL_HOURS=12

# The purge cannot be switched off. It runs inside this service on every
# instance, so a deployment that configures nothing still honours a deletion.
# POST /api/internal/maintenance/purge-soft-deleted forces a pass, and
# ?dryRun=true reports what would go without removing it.
