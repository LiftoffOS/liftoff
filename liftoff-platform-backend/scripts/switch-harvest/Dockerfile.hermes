# A real Hermes installation, created from scratch.
#
# Verified against hermes-agent 0.20.4. Its layout matched our assumptions far
# better than OpenClaw's did — config.yaml, SOUL.md, memories/, skills/ and
# cron/jobs.json are all real — with one exception that mattered: a job's
# `schedule` is an OBJECT, so reading it as a string dropped every schedule on
# every real installation.
#
# Teardown is deletion of the container.

FROM node:22-bookworm-slim

ARG REVISION=latest

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git python3 sqlite3 \
 && rm -rf /var/lib/apt/lists/*

RUN if [ "$REVISION" = "latest" ]; then npm install -g hermes-agent; \
    else npm install -g "hermes-agent@$REVISION"; fi

RUN hermes --version

COPY drive.sh /harvest/drive.sh
RUN chmod +x /harvest/drive.sh

WORKDIR /root
