{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/contracts/connector-get-credentials.response.schema.json",
  "title": "ConnectorGetCredentialsResponse",
  "description": "Response from POST /api/connectors/credentials. Discriminated on flowKind — exactly one of oauth / apiKey / keypair is present.",
  "type": "object",
  "required": ["flowKind"],
  "additionalProperties": false,
  "properties": {
    "flowKind": {
      "type": "string",
      "enum": ["static_oauth", "dynamic_client_registration", "api_key", "keypair", "none"]
    },
    "oauth": {
      "type": "object",
      "required": ["accessToken"],
      "additionalProperties": false,
      "properties": {
        "accessToken": { "type": "string", "minLength": 1 },
        "refreshToken": { "type": "string" },
        "expiresAtEpochSec": { "type": "integer", "minimum": 0 },
        "scopes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "extra": { "type": "object" }
      }
    },
    "apiKey": {
      "type": "object",
      "required": ["apiKey"],
      "additionalProperties": false,
      "properties": {
        "apiKey": { "type": "string", "minLength": 1 },
        "extra": { "type": "object" }
      }
    },
    "keypair": {
      "type": "object",
      "required": ["publicKey", "privateKey"],
      "additionalProperties": false,
      "properties": {
        "publicKey": { "type": "string", "minLength": 1 },
        "privateKey": { "type": "string", "minLength": 1 },
        "keyId": { "type": "string" },
        "extra": { "type": "object" }
      }
    }
  }
}
