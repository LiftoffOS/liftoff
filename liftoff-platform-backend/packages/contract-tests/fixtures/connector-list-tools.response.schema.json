{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/contracts/connector-list-tools.response.schema.json",
  "title": "ConnectorListToolsResponse",
  "description": "Response from POST /api/connectors/list-tools. Returns one ConnectorToolSet per requested connector type with its function-level JSON schemas. version is a monotonic server-assigned tag; callers pass it back as cachedVersion to skip the payload when nothing has changed (unchanged=true).",
  "type": "object",
  "required": ["toolSets", "version", "unchanged"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string" },
    "unchanged": { "type": "boolean" },
    "toolSets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["connectorType", "displayName", "tools"],
        "additionalProperties": false,
        "properties": {
          "connectorType": { "type": "string", "minLength": 1 },
          "displayName": { "type": "string", "minLength": 1 },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "description", "inputSchema", "categories", "isWrite"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "description": { "type": "string" },
                "inputSchema": { "type": "object" },
                "categories": {
                  "type": "array",
                  "items": { "type": "string", "minLength": 1 }
                },
                "isWrite": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
