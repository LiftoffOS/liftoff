{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/contracts/governance-list-approvals.response.schema.json",
  "title": "GovernanceListApprovalsResponse",
  "description": "Response from POST /api/governance/approvals.",
  "type": "object",
  "required": ["approvals"],
  "additionalProperties": false,
  "properties": {
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "workflowId",
          "taskId",
          "agentId",
          "hitlLevel",
          "status",
          "expiresAt",
          "createdAt",
          "updatedAt"
        ],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "tenantId": { "type": "string", "minLength": 1 },
          "workflowId": { "type": "string", "minLength": 1 },
          "taskId": { "type": "string", "minLength": 1 },
          "agentId": { "type": "string", "minLength": 1 },
          "hitlLevel": { "type": "integer", "minimum": 1, "maximum": 5 },
          "toolCallsHash": { "type": "string" },
          "reason": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "approved", "rejected", "expired"]
          },
          "decidedBy": { "type": ["string", "null"] },
          "decidedByRole": { "type": ["string", "null"] },
          "decision": {
            "type": ["string", "null"],
            "enum": ["approved", "rejected", null]
          },
          "rejectionReason": { "type": ["string", "null"] },
          "decidedAt": { "type": ["string", "null"], "format": "date-time" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "nextPageToken": { "type": "string" }
  }
}
