{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/contracts/tool-catalog.response.schema.json",
  "title": "ToolCatalogResponse",
  "description": "Response from GET /api/v1/tool-catalog/tenant/:tenantId/manifest/:manifestId/tools",
  "type": "object",
  "required": ["schemaVersion", "connectorType", "alias", "tools"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "connectorType": { "type": "string", "minLength": 1 },
    "alias": { "type": "string", "minLength": 1 },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "description", "input_schema"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "input_schema": { "type": "object" }
        }
      }
    }
  }
}
