{
  "name": "liftoff-platform-backend",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Liftoff Control Plane - Platform Backend",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "check:deps": "node scripts/check-dependency-integrity.js",
    "pretest": "npm run check:deps",
    "pretypecheck": "npm run check:deps",
    "prebuild": "npm run check:deps",
    "test": "jest",
    "test:changed": "jest --changedSince=main",
    "test:integration": "jest --config jest.integration.config.js",
    "migrate": "node-pg-migrate",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "ci-fences": "scripts/ci-fences/user-facing-copy-fence.sh src packages && scripts/ci-fences/legacy-literal-fence.sh src packages && scripts/ci-fences/workflow-step-case-fence.sh src packages && scripts/ci-fences/shared-types-drift-fence.sh src packages && scripts/ci-fences/assistant-message-boundary-fence.sh src && scripts/ci-fences/system-agent-rls-fence.sh migrations && scripts/ci-fences/migration-force-rls-fence.sh migrations",
    "backfill": "node dist/scripts/backfill-agent-instructions-md.js",
    "sync:connectors": "ts-node --transpile-only scripts/sync-connector-static-fallback.ts",
    "rls:tables": "ts-node --transpile-only scripts/generate-rls-tables.ts",
    "calibrate:capability-discovery": "ts-node --transpile-only scripts/calibrate-capability-discovery.ts",
    "migrate:developer-proxy-keys": "ts-node --transpile-only scripts/migrate-keys-to-developer-proxy.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@coinbase/cdp-sdk": "1.55.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@google-cloud/bigquery": "^8.1.1",
    "@google-cloud/cloudbuild": "^5.5.0",
    "@google-cloud/monitoring": "^5.3.1",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@google-cloud/pubsub": "^4.0.0",
    "@google-cloud/run": "^3.2.0",
    "@google-cloud/scheduler": "^5.3.1",
    "@google-cloud/secret-manager": "^5.0.0",
    "@google-cloud/speech": "^7.5.0",
    "@google-cloud/storage": "^7.0.0",
    "@google-cloud/tasks": "^4.0.0",
    "@google-cloud/text-to-speech": "^6.4.1",
    "@google-cloud/vertexai": "^1.9.0",
    "@liftoffos/browser-record": "*",
    "@liftoffos/browser-tools": "*",
    "@liftoffos/chat-attachments": "*",
    "@liftoffos/connector-types": "*",
    "@liftoffos/database": "*",
    "@liftoffos/embedding": "*",
    "@liftoffos/governance-types": "*",
    "@liftoffos/injection-detector": "*",
    "@liftoffos/mcp-transports": "*",
    "@liftoffos/proto-gen": "*",
    "@liftoffos/pubsub": "*",
    "@liftoffos/redact": "*",
    "@liftoffos/service-client": "*",
    "@liftoffos/shared-types": "*",
    "@liftoffos/telemetry": "*",
    "@liftoffos/workforce-types": "*",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@simplewebauthn/server": "^11.0.0",
    "@types/ws": "^8.18.1",
    "@typesafe-ai/sdk": "^0.6.0",
    "ajv": "^8.18.0",
    "botbuilder": "^4.23.3",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "eventsource-parser": "^3.0.6",
    "express": "^4.18.0",
    "express-rate-limit": "^8.6.1",
    "firebase-admin": "^14.3.0",
    "googleapis": "^171.4.0",
    "js-yaml": "^4.3.1",
    "jszip": "^3.10.1",
    "mammoth": "*",
    "multer": "^2.2.0",
    "openai": "^4.77.0",
    "p-limit": "^3.1.0",
    "parquetjs-lite": "^0.8.0",
    "pdf-parse": "*",
    "pg": "^8.11.0",
    "pino": "^8.17.0",
    "rate-limiter-flexible": "^11.0.1",
    "stripe": "^14.0.0",
    "ws": "^8.21.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^29.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "lint-staged": "^16.4.0",
    "node-pg-migrate": "^8.0.4",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.70.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "bash -c tsc --noEmit"
    ]
  },
  "overrides": {
    "ajv": {
      "fast-uri": "3.1.7"
    },
    "brace-expansion": "5.0.9",
    "fast-uri": "4.1.4",
    "fast-xml-parser": "5.10.1",
    "uuid": "^11.1.1"
  }
}
