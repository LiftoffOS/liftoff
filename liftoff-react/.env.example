# Liftoff React - Environment Variables
# Copy this file to .env and fill in the values
# All variables must be prefixed with VITE_ to be accessible in the browser

# ==============================================================================
# REQUIRED - Firebase Configuration
# ==============================================================================
#
# | Variable | Required | Description |
# |----------|----------|-------------|
# | VITE_FIREBASE_API_KEY | Yes | Firebase Web API key |
# | VITE_FIREBASE_AUTH_DOMAIN | Yes | Firebase Auth domain |
# | VITE_FIREBASE_PROJECT_ID | Yes | Firebase project ID |
# | VITE_FIREBASE_STORAGE_BUCKET | Yes | Firebase Storage bucket |
# | VITE_FIREBASE_MESSAGING_SENDER_ID | Yes | Firebase Cloud Messaging sender ID |
# | VITE_FIREBASE_APP_ID | Yes | Firebase Web app ID |
# | VITE_FIREBASE_VAPID_KEY | No | Web Push certificate public key; browser notifications are disabled without it |
#
# Get these values from Firebase Console > Project Settings > General > Your apps

VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
# Firebase Console > Project Settings > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# ==============================================================================
# REQUIRED - API Configuration
# ==============================================================================
#
# | Variable | Required | Description |
# |----------|----------|-------------|
# | VITE_API_URL | Yes | Platform Backend API URL |
#
# Local development: http://localhost:8080
# Production: https://api.example.com
# Or use the production backend for local frontend dev: https://api.example.com
#
# Deployed builds bake this from Secret Manager (project YOUR_WEB_PROJECT), per env:
#   main → dev frontend (dev.example.com) uses secret VITE_API_URL_DEV = https://api-dev.example.com
#   release → prod frontend (example.com) uses secret VITE_API_URL = https://api.example.com
# Likewise Stripe: VITE_STRIPE_PUBLISHABLE_KEY_DEV (pk_test) for dev, VITE_STRIPE_PUBLISHABLE_KEY (pk_live) for prod.

VITE_API_URL=https://api.example.com

# Developer Proxy URL — credential CRUD calls go directly to developer-proxy, not via platform-backend
# Dev: https://developer-proxy-YOUR_PROJECT_HASH-uw.a.run.app
# Prod: https://developer-proxy-YOUR_PROJECT_HASH-uw.a.run.app
VITE_DEVELOPER_PROXY_URL=https://developer-proxy-YOUR_PROJECT_HASH-uw.a.run.app

# ==============================================================================
# REQUIRED - Stripe
# ==============================================================================
#
# Publishable key for Stripe.js (safe to expose in the browser).
# Use pk_test_... for local dev, pk_live_... for production.
# Production value is stored in Secret Manager as VITE_STRIPE_PUBLISHABLE_KEY.
#
# To get a test key: Stripe Dashboard → Developers → API keys → Publishable key

VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# ==============================================================================
# OPTIONAL - Development Settings
# ==============================================================================
#
# | Variable | Required | Description |
# |----------|----------|-------------|
# | VITE_DISABLE_MSW | No | Set to 'true' to disable Mock Service Worker and use real API |
#
# By default, MSW mocks all API requests in dev mode.
# Set this to 'true' to test against the real production API.

# VITE_DISABLE_MSW=true

# ==============================================================================
# Analytics (GA4)
# ==============================================================================
#
# GA4 measurement ID (G-8G8F6BW19J) is hardcoded in src/lib/analytics.ts.
# gtag.js only loads on example.com — no env var needed.
# To smoke-test analytics on any other host, append ?ga=1 to the URL.

# ==============================================================================
# Analytics (PostHog)
# ==============================================================================
#
# | Variable | Required | Description |
# |----------|----------|-------------|
# | VITE_POSTHOG_KEY_PROD | No | PostHog project API key (phc_...) for the prod project |
# | VITE_POSTHOG_KEY_DEV  | No | PostHog project API key for the dev project |
#
# Two PostHog projects mirror the rest of our infra's dev/prod split:
#   example.com           → prod project   (VITE_POSTHOG_KEY_PROD)
#   localhost / preview URLs → dev project    (VITE_POSTHOG_KEY_DEV)
#   anywhere with `?ph=1`    → prod project   (smoke-test prod from a dev host)
#
# Both keys are `phc_...` project tokens — write-only, safe to bundle in the
# JS payload. When the matching key is unset for the current host, PostHog
# is disabled (no script load, no network calls).
#
# Production values are stored in Secret Manager (project: YOUR_WEB_PROJECT)
# as VITE_POSTHOG_KEY_PROD + VITE_POSTHOG_KEY_DEV and injected by Cloud Build.
# Host: us.i.posthog.com (hardcoded in src/lib/analytics.ts — we're US-based).

# VITE_POSTHOG_KEY_PROD=phc_your_prod_project_key_here
# VITE_POSTHOG_KEY_DEV=phc_your_dev_project_key_here

# ==============================================================================
# OPTIONAL — Dev-only escape hatches
# ==============================================================================

# Skip the DashboardOnboardingGate when running locally so iteration on the
# dashboard never gets force-redirected through /onboarding. Wired into
# `npm run dev` directly — do NOT set this in production. The gate component
# (src/components/Dashboard/DashboardOnboardingGate.tsx) reads it ONLY when
# `import.meta.env.DEV` is true, so it tree-shakes out of the production bundle.
# Run `npm run dev:onboarding` to disable the bypass and exercise the wizard.
# VITE_DEV_BYPASS_ONBOARDING_GATE=true

# Disable the Mock Service Worker so dev hits the real api-dev backend
# (VITE_API_URL) instead of the in-repo MSW stubs. Wired into `npm run dev`
# by default — the connector catalog stub in src/mocks/handlers/connectors.ts
# only mirrors a handful of types, so with MSW on /connections shows ~38
# entries instead of the ~91 the real dev backend actually serves. Run
# `npm run dev:mock` when you want MSW (offline / contract-test work).
# VITE_DISABLE_MSW=true

# Force the LiftoffScore feature flag (liftoff_score_enabled) on locally, which
# reveals the LiftoffScore section in the Insights report. Owner/admin
# only, and the backend enforces that independently. Read ONLY when
# `import.meta.env.DEV` is true (src/contexts/FeatureFlagsContext.tsx).
# VITE_LIFTOFF_SCORE_ENABLED=true

# Comma-separated email-domain allow-list for sign-in and signup. When set, the
# login page refuses any other domain (Google, email/password and passkey alike)
# with a toast and keeps the person on /login. Leave unset for no restriction,
# which is what production ships; the dev deploy sets it to example.com.
# This is the front door only — the backend authorizes on its own list
# (platform-backend ALLOWED_DOMAINS, else Firebase Remote Config
# `allowed_domains`), so the two should be set together.
# VITE_ALLOWED_EMAIL_DOMAINS=example.com
