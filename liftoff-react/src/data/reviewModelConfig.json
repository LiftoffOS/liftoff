    },
    {
      "id": "pricing",
      "action": "Pricing decisions",
      "description": "Any actions involving pricing or discounts",
      "mode": "review",
      "threshold": null,
      "category": "commercial"
    },
    {
      "id": "handoff",
      "action": "Sales handoff",
      "description": "Final handoff to sales representatives",
      "mode": "review",
      "threshold": null,
