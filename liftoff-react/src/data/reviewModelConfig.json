  "sensitiveActions": [
    "Contract commitments",
    "Discount approvals over 10%",
    "Legal language changes",
    "Customer data exports",
    "Account deletions",
    "Integration credential changes"
  ],
  "escalationRules": [
    {
      "id": "low-confidence",
      "trigger": "Confidence below threshold",
      "action": "Route to review queue",
      "priority": "normal"
    },
    {
      "id": "high-value",
      "trigger": "Deal value > $100K",
      "action": "Notify sales director",
      "priority": "high"
    },
    {
      "id": "vip-account",
      "trigger": "VIP account flag",
      "action": "Route to senior reviewer",
      "priority": "high"
    },
    {
      "id": "sla-risk",
      "trigger": "SLA deadline approaching",
      "action": "Auto-escalate to manager",
      "priority": "urgent"
    }
  ],
  "reviewerRoles": [
    { "id": "standard", "name": "Standard Reviewer", "permissions": ["approve", "reject", "edit"] },
    { "id": "senior", "name": "Senior Reviewer", "permissions": ["approve", "reject", "edit", "override", "escalate"] },
    { "id": "approver", "name": "Final Approver", "permissions": ["approve", "reject", "edit", "override", "escalate", "bypass"] }
  ]
