{
  "name": "liftoff-governance-engine",
  "version": "0.1.0",
  "private": true,
  "description": "GovernanceEngine: HITL, admission, action ledger, usage ledger, audit.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "bench": "jest --config jest.benchmark.config.js --bail --runInBand",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate",
    "partitions": "ts-node src/jobs/partitions/manage-partitions.ts",
    "reconcile": "ts-node src/jobs/reconcile/reconcile-wal-vs-governance.ts",
    "backfill": "ts-node src/jobs/backfill/backfill-from-tenant.ts",
    "collab-skill-rollup": "node dist/jobs/collab-skill-rollup/rollup-collab-skill.js",
    "prepare": "husky || true"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-express": "^2.1.1",
    "@connectrpc/connect-node": "^2.0.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@google-cloud/pubsub": "^4.0.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@google-cloud/storage": "^7.0.0",
    "@liftoffos/contract-tests": "*",
    "@liftoffos/database": "*",
    "@liftoffos/governance-types": "*",
    "@liftoffos/proto-gen": "*",
    "@liftoffos/pubsub": "*",
    "@liftoffos/service-client": "*",
    "@liftoffos/shared-types": "*",
    "@liftoffos/telemetry": "*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "dotenv": "^17.3.1",
    "express": "^4.18.0",
    "pg": "^8.11.3",
    "stripe": "^18.0.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
