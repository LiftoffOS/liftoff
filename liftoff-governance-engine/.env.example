# GovernanceEngine — local environment variables.
#
# Copy to .env and fill in values for local development. In production these
# are populated via Cloud Run --set-secrets + --set-env-vars from Secret
# Manager (see cloudbuild.yaml).

# ─── Service auth ────────────────────────────────────────────────────
# Bearer token used for X-Service-Auth on every RPC. Callers (tenant-runtime,
# platform-backend) read the same secret and put it on outbound requests.
# Plan convention is GOVERNANCE_SERVICE_TOKEN; GOVERNANCE_ENGINE_TOKEN is
# still recognized as a legacy fallback inside preflight-token.ts but no
# longer used by verifyServiceAuth.
GOVERNANCE_SERVICE_TOKEN=dev-token

# Optional: dedicated key for signing/verifying preflight tokens. If unset,
# falls back to GOVERNANCE_SERVICE_TOKEN, then GOVERNANCE_ENGINE_TOKEN.
# GOVERNANCE_PREFLIGHT_SIGNING_KEY=

# ─── Database (Cloud SQL governance-pg) ──────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=governance_engine
DB_USER=governance_app
DB_PASSWORD=

# ─── Runtime ─────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
SERVICE_VERSION=dev
COMMIT_SHA=local

# ─── Pub/Sub (kill-switch publishing) ────────────────────────────────
# Topic name follows the multiplexed "governance-events-{env}" pattern.
# The specific event type is on the message attribute `eventType`.
PUBSUB_TOPIC_KILL_SWITCH_CHANGED=governance-events-dev
PUBSUB_EVENT_TYPE_KILL_SWITCH_CHANGED=governance.kill_switch_changed
GCP_PROJECT_ID=YOUR_CONTROL_PROJECT_STAGING

# Pub/Sub topic for audit events mirrored to platform-backend.
# Unset in local dev — audit events written locally only.
AUDIT_EVENTS_TOPIC=

# Collab-skill rollup job (operator-run Cloud Run Job). Reads the consolidated
# match export from GCS and folds it into the collab_skill posterior store.
# Connects as governance_app (table owner; RLS ENABLE => owner bypass).
COLLAB_GCS_BUCKET=YOUR_GCP_PROJECT
COLLAB_ROLLUP_EPOCH=2026-05-01T00:00:00Z
COLLAB_MODEL_VERSION=mechanical-v0
