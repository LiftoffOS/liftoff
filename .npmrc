# A workspace member's .npmrc is not read from the install root, so this is
# restated here. It is load-bearing: without it `npm ci` fails outright with
# ERESOLVE.
#
# The conflict is in liftoff-tenant-runtime, which declares zod@^4 and
# @browserbasehq/stagehand@1.14.0, and that version of stagehand peers
# zod@^3.23.8. npm cannot satisfy both, so it refuses to build a tree at all.
#
# The real fix is a stagehand upgrade rather than this flag: 4.x carries
# zod 4 as an ordinary dependency and peers nothing, so the conflict
# disappears. That is a three-major jump with API changes through the
# browser code, which is its own piece of work.
#
# The comment here used to name @ai-sdk/anthropic@1.2.12, which peered
# zod@^3 for the same reason. That dependency is gone; stagehand is what
# keeps the flag necessary now.
#
# What this flag is NOT is the thing that makes the zod majors work. Seven
# members declare zod ^3 and the runtime declares ^4, so npm hoists 3.x and
# nests 4.x under the runtime regardless. What makes the runtime compile is
# the `paths` block in its OWN tsconfig, which pins zod to its nested copy for
# the whole program including the .d.ts files it pulls in - fixed in that repo
# rather than here, so the standalone build gets it too.
legacy-peer-deps=true
