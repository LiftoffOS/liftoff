{
  "name": "liftoff-connector-service",
  "version": "0.1.0",
  "private": true,
  "description": "ConnectorService \u2014 OAuth flows, credential storage, 50+ connector clients, MCP sidecars, capability registry.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && node scripts/copy-generated-assets.js",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "test": "jest",
    "test:integration": "jest --config jest.integration.config.js",
    "bench": "jest --config jest.benchmark.config.js --bail --runInBand",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate",
    "gen:registry": "ts-node --require ./scripts/ts-node-js-resolver.cjs --transpile-only --project scripts/tsconfig.json scripts/generate-registry/run.ts",
    "gen:locus-parse": "ts-node --require ./scripts/ts-node-js-resolver.cjs --transpile-only --project scripts/tsconfig.json scripts/locus-catalog-sync.ts",
    "gen:connector-docs": "ts-node --require ./scripts/ts-node-js-resolver.cjs --transpile-only --project scripts/tsconfig.json scripts/generate-connectors-md.ts",
    "propose:id-args": "ts-node --require ./scripts/ts-node-js-resolver.cjs --transpile-only --project scripts/tsconfig.json scripts/propose-id-args.ts",
    "gen:connector-tools": "ts-node --require ./scripts/ts-node-js-resolver.cjs --transpile-only --project scripts/tsconfig.json scripts/gen-connector-tools.ts",
    "classify:tools": "ts-node --require ./scripts/ts-node-js-resolver.cjs --project scripts/tsconfig.json scripts/classify-connector-tools.ts",
    "harvest:vendor-mcp": "ts-node --require ./scripts/ts-node-js-resolver.cjs --project scripts/tsconfig.json scripts/harvest-vendor-mcp-inventory.ts",
    "x402:circle:setup": "ts-node --require ./scripts/ts-node-js-resolver.cjs --transpile-only --project scripts/tsconfig.json scripts/x402-circle-setup.ts",
    "composio:bootstrap-toolkit": "ts-node --transpile-only --project scripts/tsconfig.json src/scripts/composio-bootstrap-toolkit.ts",
    "composio:migrate-reconnect": "ts-node --transpile-only --project scripts/tsconfig.json src/scripts/composio-migrate-reconnect.ts",
    "migrate:web-tool-keys": "ts-node --transpile-only --project scripts/tsconfig.json src/scripts/migrate-platform-web-tool-keys.ts",
    "prepare": "husky || true",
    "gen:vaaya-passthrough": "ts-node --require ./scripts/ts-node-js-resolver.cjs --transpile-only --project scripts/tsconfig.json scripts/vaaya-passthrough-sync.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@1password/sdk": "0.5.0",
    "@bufbuild/protobuf": "^2.2.0",
    "@coinbase/cdp-sdk": "1.55.0",
    "@composio/core": "^0.10.0",
    "@connectrpc/connect": "^2.0.0",
    "@connectrpc/connect-express": "^2.1.1",
    "@connectrpc/connect-node": "^2.0.0",
    "@google-cloud/pubsub": "^4.0.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@google-cloud/tasks": "^4.0.0",
    "@liftoffos/composio-overlays": "*",
    "@liftoffos/connector-types": "*",
    "@liftoffos/database": "*",
    "@liftoffos/governance-types": "*",
    "@liftoffos/mcp-transports": "*",
    "@liftoffos/proto-gen": "*",
    "@liftoffos/pubsub": "*",
    "@liftoffos/service-client": "*",
    "@liftoffos/telemetry": "*",
    "@x402/core": "2.25.0",
    "@x402/evm": "2.25.0",
    "@x402/express": "2.25.0",
    "@x402/extensions": "2.25.0",
    "@x402/fetch": "2.25.0",
    "@x402/svm": "2.25.0",
    "@xmldom/xmldom": "^0.9.10",
    "dotenv": "^17.3.1",
    "express": "^4.18.0",
    "fast-xml-parser": "^5.9.3",
    "google-auth-library": "9.15.0",
    "multer": "^1.4.5-lts.1",
    "node-sql-parser": "5.4.0",
    "pg": "^8.11.3",
    "viem": "2.56.3",
    "xml-crypto": "^6.1.2",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "ajv": "^6.15.0",
    "eslint": "^8.57.0",
    "eslint-plugin-r5-local": "file:eslint-rules",
    "husky": "^9.1.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.0.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
