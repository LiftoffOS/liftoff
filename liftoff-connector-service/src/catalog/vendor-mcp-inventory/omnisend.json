  "tools": [
    {
      "name": "execute",
      "description": "Execute an Omnisend API call by tool name. You must have called tool_schema and tool_documentation for this tool_name in the session before calling execute; payload must match inputSchema from tool_schema.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tool_name": {
            "type": "string",
            "description": "Exact tool name as returned by search"
          },
          "payload": {
            "type": "object",
            "description": "Object whose keys match the tool input schema (path params, query, or body)",
            "additionalProperties": true
          }
        },
        "required": [
          "tool_name",
          "payload"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "search",
      "description": "List all Omnisend API tools available through execute, with short descriptions. The full list is always returned (any query argument is ignored).",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "Ignored; kept for compatibility. All tools are always returned."
          }
        },
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "tool_documentation",
      "description": "Return markdown for an API tool: curated notes plus a generated appendix from the live JSON Schema (enums, required fields). For raw schema only, use tool_schema.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "tool_name": {
            "type": "string",
            "description": "Exact tool name as returned by search"
          }
        },
        "required": [
          "tool_name"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false
      }
    },
    {
      "name": "tool_schema",
      "description": "Return the JSON Schema (inputSchema) and annotation summary for a single API tool by name.",
      "inputSchema": {
        "type": "object",
        "properties": {
