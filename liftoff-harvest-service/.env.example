NODE_ENV=development
PORT=8080
LOG_LEVEL=info
ENVIRONMENT=dev

# Platform backend
PLATFORM_BACKEND_URL=http://localhost:3000
HARVEST_SERVICE_TOKEN=

# Tenant runtime
HARVEST_TENANT_RUNTIME_SERVICE_TOKEN=
TENANT_RUNTIME_URL=http://localhost:4000

# Database (Cloud SQL in prod, local pg in dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=harvest
DB_USER=harvest_app
DB_PASSWORD=
# DB_SOCKET_PATH=/cloudsql/YOUR_PROJECT:YOUR_REGION:YOUR_INSTANCE  # Cloud SQL socket (prod)

# Pub/Sub
GCP_PROJECT_ID=YOUR_CONTROL_PROJECT_STAGING

# Harvest config
MIN_HARVEST_LENGTH=150
HARVEST_CONFIDENCE_THRESHOLD=0.7
# Memories at/above this confidence also get the `harvest:high-confidence` tag
# (consumed by tenant-runtime's narrow_with_peer memory strategy).
HARVEST_HIGH_CONFIDENCE_THRESHOLD=0.9
