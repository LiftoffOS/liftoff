{
  "name": "liftoff-harvest-service",
  "version": "0.1.0",
  "private": true,
  "description": "Harvest service: Pub/Sub pull subscriber \u2192 adaptive filter \u2192 LLM classifier \u2192 institutional memory writes.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn src/index.ts",
    "test": "jest",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "migrate": "node-pg-migrate -m migrations",
    "partitions": "ts-node src/jobs/manage-partitions.ts",
    "reharvest": "ts-node src/jobs/reharvest.ts",
    "backfill": "node dist/jobs/reharvest.js --mode backfill",
    "prepare": "husky || true"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@google-cloud/pubsub": "^4.0.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@liftoffos/proto-gen": "*",
    "@liftoffos/service-client": "*",
    "@liftoffos/shared-types": "*",
    "dotenv": "^17.3.1",
    "express": "^4.18.0",
    "pg": "^8.11.3",
    "pino": "^9.5.0",
    "uuid": "^9.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.9",
    "@types/pino": "^7.0.5",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.0",
    "husky": "^9.1.0",
    "jest": "^29.7.0",
    "node-pg-migrate": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
