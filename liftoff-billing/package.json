{
  "name": "liftoff-billing",
  "version": "0.1.0",
  "description": "Liftoff billing service \u2014 Stripe subscriptions, invoicing, meter events, credit balance.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check:deps": "node scripts/check-dependency-integrity.cjs",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint \"src/**/*.ts\" \"tools/**/*.ts\"",
    "lint:rls": "node -e \"import('@liftoffos/database').then(m => m.runRlsFence('src', { extraWrappers: ['withBillingTenant', 'withCrossTenant'] }).then(v => { if(v.length){ console.error(v); process.exit(1) } else { console.log('rls-fence OK'); } }))\"",
    "migrate": "node-pg-migrate",
    "prebuild": "npm run check:deps",
    "prelint": "npm run check:deps",
    "prelint:rls": "npm run check:deps",
    "pretest": "npm run check:deps",
    "pretest:integration": "npm run check:deps",
    "pretypecheck": "npm run check:deps",
    "start": "node dist/index.js",
    "test": "jest",
    "test:compat": "node dist/__tests__/n-minus-1-compat.test.js",
    "test:contracts": "jest --testPathPattern contract --passWithNoTests",
    "test:integration": "jest --config jest.integration.config.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-fastify": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@google-cloud/monitoring": "^4.0.0",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@google-cloud/pubsub": "^4.0.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@google-cloud/storage": "^7.0.0",
    "@liftoffos/billing-types": "*",
    "@liftoffos/contract-tests": "*",
    "@liftoffos/database": "*",
    "@liftoffos/outbox": "*",
    "@liftoffos/proto-gen": "*",
    "@liftoffos/pubsub": "*",
    "@liftoffos/service-client": "*",
    "@liftoffos/service-runtime": "*",
    "@liftoffos/telemetry": "*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.79.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify": "^5.11.2",
    "node-pg-migrate": "^7.0.0",
    "pg": "^8.11.0",
    "stripe": "^14.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.20.4",
    "@types/pg-copy-streams": "^1.2.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "pg-copy-streams": "^6.0.0",
    "ts-jest": "^29.4.12",
    "tsx": "^4.23.11",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "fast-xml-parser": "^5.2.5",
    "form-data": "^4.0.4",
    "glob": "^11.1.0",
    "protobufjs": "^7.6.3",
    "fast-xml-builder": "^1.1.7"
  }
}
