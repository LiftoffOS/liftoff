{
  "name": "@liftoffos/proto-gen",
  "version": "0.29.0",
  "description": "Generated TypeScript stubs for Liftoff proto contracts (Connect-RPC). Regenerated by `buf generate`.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./event-schemas": {
      "types": "./event-schemas/index.d.ts",
      "default": "./event-schemas/index.js"
    },
    "./dist/*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "event-schemas"
  ],
  "scripts": {
    "generate": "buf generate",
    "build": "tsc",
    "clean": "rm -rf dist && find gen/ts -name '*_pb.ts' -delete",
    "regenerate": "npm run clean && npm run generate && npm run build",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LiftoffOS/liftoff",
    "directory": "liftoff-proto"
  },
  "author": "Liftoff",
  "license": "Apache-2.0",
  "dependencies": {
    "@bufbuild/protobuf": "^2.2.0",
    "@connectrpc/connect": "^2.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.10.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "typescript": "^5.3.3"
  }
}
