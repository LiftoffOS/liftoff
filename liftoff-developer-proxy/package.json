{
  "name": "liftoff-developer-proxy",
  "version": "0.1.0",
  "description": "Liftoff Developer Proxy \u2014 vendor-agnostic API key management and transparent HTTP proxy for Claude Code",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "migrate": "node-pg-migrate",
    "migrate:backfill": "tsx tools/migration/backfill.ts",
    "migrate:setup-replication": "tsx tools/migration/setup-logical-replication.ts",
    "migrate:cutover": "tsx tools/migration/cutover-runner.ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-fastify": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@fastify/cors": "^10.0.1",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@google-cloud/pubsub": "^4.0.0",
    "@google-cloud/secret-manager": "^5.0.0",
    "@google-cloud/storage": "^7.21.0",
    "@liftoffos/billing-types": "*",
    "@liftoffos/database": "*",
    "@liftoffos/outbox": "*",
    "@liftoffos/proto-gen": "*",
    "@liftoffos/service-client": "*",
    "@liftoffos/service-runtime": "*",
    "@liftoffos/telemetry": "*",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify": "^5.11.2",
    "fastify-plugin": "^4.5.0",
    "firebase-admin": "^13.8.0",
    "node-pg-migrate": "^7.0.0",
    "pg": "^8.11.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.10.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "tsx": "^4.0.0",
    "typescript": "^5.3.3"
  }
}
